                    imgui.PushStyleColor(imgui.Col.ButtonHovered, COL_BTN_HOVER)
                    imgui.PushStyleColor(imgui.Col.ButtonActive, COL_BTN_ACTIVE)
                end
                if imgui.Button(m[2] .. "##imgmode" .. i, imgui.ImVec2(120, 28)) then
                    ini.MARKER.IMAGE_MODE = m[1]
                    saveConfig()
                    if m[1] ~= 'fixed' then
                        local n = preloadAllImages()
                        pushToast('Modo ' .. m[2] .. ' (' .. n .. ' imgs)', true)
                    else
                        reloadImage()
                        pushToast('Modo FIXA', true)
                    end
                end
                imgui.PopStyleColor(3)
                if i < #modes then imgui.SameLine() end
            end

            imgui.Spacing()
            if mode == 'fixed' then
                imgui.TextColored(COL_TEXT_MUTED, "Usa sempre a imagem selecionada abaixo.")
            elseif mode == 'random' then
                imgui.TextColored(COL_TEXT_OK, "Cada acerto sorteia uma PNG da pasta.")
            else
                imgui.TextColored(COL_TEXT_OK, "Cada acerto avanca para a proxima PNG.")
            end
            endCard()

            imgui.Spacing()

            beginCard("##card_image", 160)
            imgui.TextColored(COL_TEXT_MUTED, "IMAGEM DO ACERTO")
            imgui.Spacing()

            local currentName = ini.MARKER.IMAGE_PATH
            if currentName and currentName ~= '' then
                local nameOnly = currentName:match("([^\\/]+)$") or currentName
                imgui.TextColored(COL_TEXT, "Selecionada (modo FIXA):  " .. nameOnly)
            else
                imgui.TextColored(COL_TEXT_MUTED, "Nenhuma imagem selecionada")
            end
            imgui.TextColored(COL_TEXT_MUTED, string.format("Pre-carregadas: %d / %d", #image_order, #image_files))
            imgui.Spacing()

            fileList("##hm_image_list", 85, image_files, ini.MARKER.IMAGE_PATH, IMAGES_DIR,
