-- ============================================================
-- HELPERS DE ANIMAÇÃO (leves, via os.clock)
-- ============================================================
local function pulse(speed, minA, maxA)
    local t = os.clock() * (speed or 2.0)
    local s = (math.sin(t) + 1.0) * 0.5
    return minA + (maxA - minA) * s
end

local function lerpColor(a, b, t)
    return imgui.ImVec4(
        a.x + (b.x - a.x) * t,
        a.y + (b.y - a.y) * t,
        a.z + (b.z - a.z) * t,
        a.w + (b.w - a.w) * t
    )
end

