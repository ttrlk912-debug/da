   _esp_color_box     = imgui.new.float[3](1.0, 1.0, 1.0)
   _esp_color_blocked = imgui.new.float[3](1.0, 0.0, 0.0)
   _esp_color_name    = imgui.new.float[3](1.0, 1.0, 1.0)
   _esp_color_id      = imgui.new.float[3](1.0, 0.0, 1.0)
   _esp_color_line    = imgui.new.float[3](1.0, 1.0, 1.0)

   _puxar_dist_slider = imgui.new.float(_puxar_max_distance)
   _puxar_cmd_buffer  = imgui.new.char[64]("")

   _updateIP()
   _loadConfig()

   _puxar_dist_slider[0] = _puxar_max_distance
   ffi.copy(_puxar_cmd_buffer, _puxar_server_cmd)

   addEventHandler("onScriptTerminate", _scriptTerminateHandler)

   _writeWallshot()
   _writeInfRun(false)

   -- Thread que atualiza a lista do puxar arma em background
   lua_thread.create(function()
      while true do
         wait(500)
         if _menu_tab == "Puxar Arma" and _window[0] then
            _puxar_refreshList()
         end
      end
   end)

   local last_bone_upd = os.clock()

   while true do
      _legit = nil

      if not sampIsChatInputActive() and not isSampfuncsConsoleActive() and not sampIsDialogActive() then
         if isKeyJustPressed(_config.menubutton) and (_config.combobutton == 0 or isKeyDown(_config.combobutton)) then
            if _window[0] then _saveConfig() end
            _window[0] = not _window[0]
         elseif not _config.lockactive and isKeyJustPressed(_config.statebutton) and (_config.combobutton == 0 or isKeyDown(_config.combobutton)) then
            _state[0] = not _state[0]
         elseif _config.lockactive then
            _state[0] = isKeyDown(_config.lockbutton)
         end
      end

      local weapon = _getWeapon()

      if _state[0] and weapon then
         if os.clock() - last_bone_upd >= _pref_bone_upd[0] and (isButtonPressed(player, 0) or isButtonPressed(player, 1)) then
            last_bone_upd = os.clock()
            _pref_bone[0] = _getRandomBone()
         end

         local sight_2d = _getSightPos()
         local sight_3d = vector3d(convertScreenCoordsToWorld3D(sight_2d.x, sight_2d.y, 1))
         local tdist = (_config.indivfov and _config.guns[weapon.name].fov or _config.fov) * 10

         if _config.debug then
            renderDrawPolygon(sight_2d.x, sight_2d.y, tdist * 2, tdist * 2, 50, 0, 0x2000ff00)
         end

         local temp_bones = {}
         for _, dot in ipairs(_bones[_pref_bone[0]].dots) do
            table.insert(temp_bones, dot)
         end
         if _last_bone and not _isTableHasValue(temp_bones, _last_bone) then
            table.insert(temp_bones, _last_bone)
         end
         for k, bone in ipairs(_bones) do
            if k ~= _pref_bone[0] then
               for _, dot in ipairs(bone.dots) do
                  table.insert(temp_bones, dot)
               end
            end
         end

         local my_color
         if _config.ignoremyclist then
            my_color = sampGetPlayerColor(select(2, sampGetPlayerIdByCharHandle(PLAYER_PED)))
         end

         for _, ped in ipairs(getAllChars()) do
            if ped ~= PLAYER_PED and isCharOnScreen(ped) then
               local result, id = sampGetPlayerIdByCharHandle(ped)
               if result then
                  local skip = false
                  if _config.ignoremyclist and my_color == sampGetPlayerColor(id) then skip = true end
                  if not skip and (_config.ignorebynick and _isTableHasValue(_ignored_nicks, sampGetPlayerNickname(id)) or _config.ignorebyskin and _isTableHasValue(_ignored_skins, getCharModel(ped))) then skip = true end

                  if not skip then
                     for _, bone in ipairs(temp_bones) do
                        local peds_bone = _getBodyPart(bone, ped)
                        local bone_2d = _vector2d(convert3DCoordsToScreen(peds_bone:get()))
                        local dist_sight = getDistanceBetweenCoords2d(bone_2d.x, bone_2d.y, sight_2d.x, sight_2d.y)
                        local dist = getDistanceBetweenCoords3d(sight_3d.x, sight_3d.y, sight_3d.z, peds_bone:get())
                        if dist_sight < tdist and dist < weapon.dist and (not _legit or _legit.dist_sight > dist_sight) and not isCharDead(ped) and not sampIsPlayerPaused(id) and isLineOfSightClear(sight_3d.x, sight_3d.y, sight_3d.z, peds_bone.x, peds_bone.y, peds_bone.z, not _config.ignoreobj, not _config.ignoreveh, false, not _config.ignoreobj, false) then
                           _legit = { dist = dist, dist_sight = dist_sight, bone_num = bone, bone = peds_bone, ped = ped, id = id }
                           break
                        end
                     end
                  end
               end
            end
         end

         if _legit then
            _last_bone = _legit.bone_num
            if _config.debug then
               local tar_2d = _vector2d(convert3DCoordsToScreen(_legit.bone:get()))
               renderDrawLine(sight_2d.x, sight_2d.y, tar_2d.x, tar_2d.y, 1, -1)
               renderDrawBox(tar_2d.x, tar_2d.y, 5, 5, 0xffff0000)
               renderFontDrawText(font, math.floor(_legit.dist_sight), sight_2d.x + 20, sight_2d.y - 15, 0xFFFF0000)
            end
         end
      end

      drawESP()

      wait(0)
   end
end



