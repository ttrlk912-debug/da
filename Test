async def send_member_notification(guild: discord.Guild, member: discord.Member, event: str, role: discord.Role | None = None, youtube_author: dict | None = None) -> None:
    settings = get_settings(guild.id)
    if event == "join":
        channel_id = settings.get("join_channel_id") or settings.get("notification_channel_id")
    elif event == "leave":
        channel_id = settings.get("leave_channel_id")
    else:
        channel_id = settings.get("notification_channel_id")
    if not channel_id:
        return
    channel = guild.get_channel(int(channel_id))
    if not isinstance(channel, discord.TextChannel):
        try:
            channel = await guild.fetch_channel(int(channel_id))
        except (discord.NotFound, discord.Forbidden, discord.HTTPException):
            return
    if not isinstance(channel, discord.TextChannel):
        return

    if event == "join":
        embed = discord.Embed(
            title="Novo membro chegou",
            description=f"{discord.utils.escape_markdown(member.display_name)} entrou no servidor.",
            color=discord.Color.blurple(),
        )
        embed.add_field(name="Cargo automático", value=role.mention if role else "Nenhum cargo automático foi atribuído.", inline=False)
        embed.set_footer(text="Aviso enviado no canal de entradas")
    elif event == "leave":
        embed = discord.Embed(
            title="Membro saiu do servidor",
            description=f"{discord.utils.escape_markdown(member.display_name)} saiu do servidor.",
            color=discord.Color.dark_grey(),
        )
        embed.add_field(name="Nome de usuário", value=discord.utils.escape_markdown(member.name), inline=True)
        embed.set_footer(text="Aviso enviado no canal de saídas")
    else:
        embed = discord.Embed(
            title="Verificação concluída",
            description=f"{discord.utils.escape_markdown(member.display_name)} confirmou o comentário e a inscrição visível, vinculou o canal do YouTube e recebeu {role.mention if role else 'o cargo configurado'}.",
            color=discord.Color.green(),
        )
        if youtube_author:
            author_name = discord.utils.escape_markdown(youtube_author.get("author_display_name") or "Nome público indisponível")
