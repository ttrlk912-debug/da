async def ensure_member_role(guild: discord.Guild) -> discord.Role | None:
    me = guild.me
    if me is None or not me.guild_permissions.manage_roles:
        return None
    settings = get_settings(guild.id)
    reward_role_id = int(settings["reward_role_id"]) if settings.get("reward_role_id") else None
    member_role = guild.get_role(int(settings["join_role_id"])) if settings.get("join_role_id") else None
    if member_role and member_role.id != reward_role_id and not member_role.managed and member_role < me.top_role:
        return member_role

    # Reuse a safe, existing member role where possible; never reuse the verification reward role.
    has_reward_named_member = any(r.id == reward_role_id and r.name.casefold() == "membro" for r in guild.roles)
    candidate_names = ("Membro inicial", "Membro") if has_reward_named_member else ("Membro", "Membro inicial")
    member_role = next(
        (r for name in candidate_names for r in guild.roles if r.name.casefold() == name.casefold() and r.id != reward_role_id and not r.managed and r < me.top_role),
        None,
    )
    if member_role is None:
        preferred_name = candidate_names[0]
        member_role = await guild.create_role(
            name=preferred_name,
            mentionable=False,
            reason="Cargo comum de novos membros criado pelo bot",
        )
    update_settings(guild.id, join_role_id=member_role.id, auto_role_on_join=1)
    return member_role


async def ensure_setup_resources(guild: discord.Guild, category_name: str, role_name: str) -> dict:
    me = guild.me
    if me is None or not me.guild_permissions.manage_channels or not me.guild_permissions.manage_roles:
        raise RuntimeError("O bot precisa das permissões **Gerenciar canais** e **Gerenciar cargos** para executar /criar.")

    settings = get_settings(guild.id)
    category = guild.get_channel(int(settings["category_id"])) if settings.get("category_id") else None
    if not isinstance(category, discord.CategoryChannel):
        category = await guild.create_category(
            category_name[:100],
            reason=f"Estrutura de verificação criada por {guild.me.id}",
        )
        update_settings(guild.id, category_id=category.id)
    elif category.name != category_name[:100]:
        await category.edit(name=category_name[:100], reason="Nome atualizado pelo comando /criar")

    reward_role = guild.get_role(int(settings["reward_role_id"])) if settings.get("reward_role_id") else None
    if reward_role is None:
        reward_role = discord.utils.get(guild.roles, name=role_name[:100])
    if reward_role is None:
        reward_role = await guild.create_role(
            name=role_name[:100],
            mentionable=False,
            reason="Cargo de recompensa criado pelo comando /criar",
        )
    if reward_role.managed or reward_role >= me.top_role:
        raise RuntimeError("O cargo de recompensa está acima do cargo do bot ou é gerenciado. Mova o cargo do bot para cima e tente novamente.")
    update_settings(guild.id, reward_role_id=reward_role.id)
    member_role = await ensure_member_role(guild)
    if member_role is None:
        raise RuntimeError("Não consegui criar ou preparar o cargo dos novos membros. Confira Gerenciar cargos e a hierarquia do bot.")

    read_only = discord.PermissionOverwrite(
        view_channel=True,
        read_message_history=True,
        send_messages=False,
        add_reactions=False,
    )
    bot_permissions = discord.PermissionOverwrite(
        view_channel=True,
        read_message_history=True,
        send_messages=True,
        embed_links=True,
        manage_messages=True,
    )
    overwrites = {guild.default_role: read_only, me: bot_permissions}

    player_channel = guild.get_channel(int(settings["player_channel_id"])) if settings.get("player_channel_id") else None
    player_was_recreated = not isinstance(player_channel, discord.TextChannel) or player_channel.category_id != category.id
    if player_was_recreated:
        player_channel = await guild.create_text_channel(
            "verificar-comentario",
            category=category,
            overwrites=overwrites,
            topic="Gere seu código, comente no vídeo configurado e use o botão para verificar.",
            reason="Canal do painel de verificação criado por /criar",
        )

    notice_channel = guild.get_channel(int(settings["notification_channel_id"])) if settings.get("notification_channel_id") else None
    if not isinstance(notice_channel, discord.TextChannel) or notice_channel.category_id != category.id:
        notice_channel = await guild.create_text_channel(
            "notificacoes",
            category=category,
            overwrites=overwrites,
            topic="Avisos de verificações concluídas, conforme a configuração da staff.",
            reason="Canal de notificações criado por /criar",
        )

    join_channel = guild.get_channel(int(settings["join_channel_id"])) if settings.get("join_channel_id") else None
    join_channel_was_created = not isinstance(join_channel, discord.TextChannel) or join_channel.category_id != category.id
    if join_channel_was_created:
        join_channel = await guild.create_text_channel(
            "entradas",
            category=category,
            overwrites=overwrites,
            topic="Avisos de novos membros e atribuição do cargo inicial.",
            reason="Canal de entrada de membros criado por /criar",
        )

    leave_channel = guild.get_channel(int(settings["leave_channel_id"])) if settings.get("leave_channel_id") else None
    leave_channel_was_created = not isinstance(leave_channel, discord.TextChannel) or leave_channel.category_id != category.id
    if leave_channel_was_created:
        leave_channel = await guild.create_text_channel(
            "saidas",
            category=category,
            overwrites=overwrites,
            topic="Avisos quando membros deixam o servidor.",
            reason="Canal de saída de membros criado por /criar",
        )

    updates = {
        "category_id": category.id,
        "player_channel_id": player_channel.id,
        "notification_channel_id": notice_channel.id,
        "join_channel_id": join_channel.id,
        "leave_channel_id": leave_channel.id,
    }
    if join_channel_was_created:
        updates["notify_on_join"] = 1
    if leave_channel_was_created:
        updates["notify_on_leave"] = 1
    if player_was_recreated:
        updates["player_message_id"] = None
    update_settings(guild.id, **updates)
    return {
        "category": category,
        "player": player_channel,
        "notifications": notice_channel,
        "entries": join_channel,
        "exits": leave_channel,
        "role": reward_role,
        "member_role": member_role,
    }


async def generate_code(interaction: discord.Interaction) -> None:
    if not interaction.guild or not isinstance(interaction.user, discord.Member):
        await interaction.response.send_message("Use o painel dentro do servidor.", ephemeral=True)
        return
    s = get_settings(interaction.guild.id)
    if not s.get("video_id"):
        await interaction.response.send_message("A staff ainda não configurou o vídeo.", ephemeral=True)
        return
    if not s.get("reward_role_id"):
        await interaction.response.send_message("A staff ainda não configurou o cargo de recompensa.", ephemeral=True)
        return
    if not get_youtube_api_key():
        await interaction.response.send_message("A verificação ainda não está disponível; a chave da API não foi configurada.", ephemeral=True)
        return
    test_mode = is_test_account(interaction.guild.id, interaction.user.id)
    reward = interaction.guild.get_role(int(s["reward_role_id"]))
    if reward and reward in interaction.user.roles and not test_mode:
        await interaction.response.send_message("Você já tem o cargo de verificação.", ephemeral=True)
        return
    if not test_mode:
        with db_connect() as conn:
            already_verified = conn.execute(
                "SELECT 1 FROM verifications WHERE guild_id=? AND user_id=?",
                (interaction.guild.id, interaction.user.id),
            ).fetchone()
        if already_verified:
            await interaction.response.send_message(
                "Sua verificação continua registrada neste servidor, mesmo que o cargo tenha sido removido. Se a staff autorizou uma nova tentativa, peça para usar **Remover verificado** primeiro.",
                ephemeral=True,
            )
            return

    now = utc_now()
    code = None
    expires = now + timedelta(minutes=int(s["code_ttl_minutes"]))
    with db_connect() as conn:
        conn.execute("BEGIN IMMEDIATE")
        old = conn.execute("SELECT code,video_id,expires_at,used_at FROM comment_codes WHERE guild_id=? AND user_id=?", (interaction.guild.id, interaction.user.id)).fetchone()
        if old and old["used_at"] and not test_mode:
            await interaction.response.send_message(
                "Esse código já foi utilizado. Se a staff autorizou uma nova tentativa, peça para usar **Remover verificado** no painel staff.",
                ephemeral=True,
            )
            return
        if old and not old["used_at"] and old["video_id"] == s["video_id"]:
            try:
                old_expiry = datetime.fromisoformat(old["expires_at"])
                if old_expiry.tzinfo is None:
                    old_expiry = old_expiry.replace(tzinfo=timezone.utc)
                if old_expiry > now:
                    code = old["code"]
                    expires = old_expiry
            except ValueError:
                pass
        if code is None:
            for _ in range(10):
                digits = "".join(str(secrets.randbelow(10)) for _ in range(int(s["code_digits"])))
                candidate = f"VERIF-{digits}"
                collision = conn.execute("SELECT 1 FROM comment_codes WHERE guild_id=? AND code=?", (interaction.guild.id, candidate)).fetchone()
                if not collision:
                    code = candidate
                    break
            if code is None:
                await interaction.response.send_message("Não consegui gerar um código único agora. Tente novamente.", ephemeral=True)
                return
            conn.execute(
                """INSERT INTO comment_codes(guild_id,user_id,code,video_id,created_at,expires_at,used_at,comment_id,author_channel_id,last_attempt_at,subscriber_checked_at)
                VALUES(?,?,?,?,?,?,NULL,NULL,NULL,NULL,NULL)
                ON CONFLICT(guild_id,user_id) DO UPDATE SET code=excluded.code,video_id=excluded.video_id,created_at=excluded.created_at,expires_at=excluded.expires_at,used_at=NULL,comment_id=NULL,author_channel_id=NULL,author_display_name=NULL,last_attempt_at=NULL,subscriber_checked_at=NULL""",
                (interaction.guild.id, interaction.user.id, code, s["video_id"], now.isoformat(), expires.isoformat()),
            )
        else:
            conn.execute("UPDATE comment_codes SET last_attempt_at=NULL WHERE guild_id=? AND user_id=?", (interaction.guild.id, interaction.user.id))

    embed = make_code_embed(code, s["video_id"], expires)
    remaining = max(1, (expires - utc_now()).total_seconds())
    view = CodeDeliveryView(code, s["video_id"], interaction.user.id, remaining)
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True, allowed_mentions=discord.AllowedMentions.none())
    try:
        await interaction.user.send(embed=embed, view=CodeDeliveryView(code, s["video_id"], interaction.user.id, remaining), allowed_mentions=discord.AllowedMentions.none())
    except (discord.Forbidden, discord.HTTPException):
        pass


def _player_verification_context(interaction: discord.Interaction):
    if not interaction.guild or not isinstance(interaction.user, discord.Member):
        raise RuntimeError("Use esta verificação dentro do servidor.")
    guild_id, user_id = interaction.guild.id, interaction.user.id
    settings = get_settings(guild_id)
    if not settings.get("video_id") or not settings.get("reward_role_id"):
        raise RuntimeError("A staff ainda não terminou de configurar a verificação.")
    test_mode = is_test_account(guild_id, user_id)
    role = interaction.guild.get_role(int(settings["reward_role_id"]))
    if role is None:
        raise RuntimeError("O cargo configurado não existe mais. Avise a staff.")
    if role in interaction.user.roles and not test_mode:
        raise RuntimeError("Você já tem o cargo de verificação.")
    with db_connect() as conn:
        if not test_mode and conn.execute(
            "SELECT 1 FROM verifications WHERE guild_id=? AND user_id=?", (guild_id, user_id)
        ).fetchone():
            raise RuntimeError("Sua verificação já está registrada. Se perdeu o cargo ou precisa refazer, fale com a staff para usar **Remover verificado**.")
        row = conn.execute("SELECT * FROM comment_codes WHERE guild_id=? AND user_id=?", (guild_id, user_id)).fetchone()
    if row is None:
        raise RuntimeError("Toque primeiro em **Gerar código**.")
    if row["used_at"]:
        raise RuntimeError("Esse código já foi consumido. Gere um código novo ou fale com a staff se já concluiu a verificação.")
    try:
        expires = datetime.fromisoformat(row["expires_at"])
        if expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
    except ValueError:
        raise RuntimeError("O código está inválido. Gere outro pelo painel.") from None
    if expires <= utc_now():
        raise RuntimeError("O código expirou. Gere outro pelo painel e publique o novo comentário.")
    return settings, test_mode, role, dict(row)


async def verify_comment_step(interaction: discord.Interaction) -> None:
    try:
        settings, test_mode, _, row = _player_verification_context(interaction)
    except RuntimeError as exc:
        await interaction.response.send_message(str(exc), ephemeral=True)
        return
    if not get_youtube_api_key():
        await interaction.response.send_message("A staff ainda não configurou a chave da YouTube Data API.", ephemeral=True)
        return
    if row.get("comment_id") and row.get("author_channel_id"):
        name = discord.utils.escape_markdown(row.get("author_display_name") or "Canal do YouTube")
        await interaction.response.send_message(
            f"**Etapa 1/2 já concluída.** O comentário foi encontrado no canal **{name}**. Agora toque em **Etapa 2: inscrição**.",
            ephemeral=True,
        )
        return
    last_attempt = row.get("last_attempt_at")
    if last_attempt:
        try:
            elapsed = (utc_now() - datetime.fromisoformat(last_attempt)).total_seconds()
            if elapsed < VERIFY_COOLDOWN_SECONDS:
                await interaction.response.send_message(f"Aguarde {int(VERIFY_COOLDOWN_SECONDS - elapsed)} segundos antes de verificar o comentário novamente.", ephemeral=True)
                return
        except ValueError:
            pass
    with db_connect() as conn:
        conn.execute(
            "UPDATE comment_codes SET last_attempt_at=? WHERE guild_id=? AND user_id=? AND used_at IS NULL",
            (now_iso(), interaction.guild.id, interaction.user.id),
        )
    code, video_id = row["code"], row["video_id"]
    await interaction.response.defer(ephemeral=True, thinking=True)
    try:
        found = await asyncio.to_thread(find_public_comment, video_id, code)
    except RuntimeError as exc:
        await interaction.followup.send(str(exc), ephemeral=True)
        return
    if not found:
        await interaction.followup.send("Ainda não encontrei seu comentário público. Confirme o código e o vídeo, aguarde a publicação pelo YouTube e tente novamente com o mesmo código.", ephemeral=True)
        return
    if not found.get("author_channel_id"):
        await interaction.followup.send("O YouTube encontrou o comentário, mas não retornou um ID de canal que permita vincular a Etapa 2. Nenhum código foi consumido; tente novamente mais tarde ou fale com a staff.", ephemeral=True)
        return
    now = utc_now()
    try:
        with db_connect() as conn:
            conn.execute("BEGIN IMMEDIATE")
            current = conn.execute("SELECT * FROM comment_codes WHERE guild_id=? AND user_id=?", (interaction.guild.id, interaction.user.id)).fetchone()
            current_expiry = datetime.fromisoformat(current["expires_at"]) if current else now
            if current_expiry.tzinfo is None:
                current_expiry = current_expiry.replace(tzinfo=timezone.utc)
            if not current or current["used_at"] or current["code"] != code or current["video_id"] != video_id or current_expiry <= now:
                raise RuntimeError("O código expirou ou mudou enquanto eu procurava o comentário. Gere outro pelo painel.")
            if not test_mode:
                linked = conn.execute(
                    "SELECT user_id FROM verification_history WHERE guild_id=? AND author_channel_id=? AND user_id!=? LIMIT 1",
                    (interaction.guild.id, found["author_channel_id"], interaction.user.id),
                ).fetchone()
                if linked:
                    raise RuntimeError("Esse canal do YouTube já foi vinculado a outra conta Discord neste servidor.")
            conn.execute(
                "UPDATE comment_codes SET comment_id=?,author_channel_id=?,author_display_name=?,subscriber_checked_at=NULL WHERE guild_id=? AND user_id=? AND used_at IS NULL",
                (found["comment_id"], found["author_channel_id"], found.get("author_display_name"), interaction.guild.id, interaction.user.id),
            )
    except sqlite3.IntegrityError:
        await interaction.followup.send("Não consegui registrar esse comentário porque ele já está associado a outra verificação.", ephemeral=True)
        return
    except RuntimeError as exc:
        await interaction.followup.send(str(exc), ephemeral=True)
        return
    author_name = discord.utils.escape_markdown(found.get("author_display_name") or "Nome público indisponível")
    author_value = f"[{author_name}](https://www.youtube.com/channel/{found['author_channel_id']}) · ID `{found['author_channel_id']}`"
    await interaction.followup.send(
        f"**Etapa 1/2 concluída:** encontrei o comentário. Canal identificado: {author_value}.\nAgora toque em **Etapa 2: inscrição** para conferir se esse canal aparece entre os inscritos visíveis do canal dono do vídeo.",
        ephemeral=True,
        allowed_mentions=discord.AllowedMentions.none(),
    )


async def verify_subscription_step(interaction: discord.Interaction) -> None:
    try:
        settings, test_mode, role, row = _player_verification_context(interaction)
    except RuntimeError as exc:
        await interaction.response.send_message(str(exc), ephemeral=True)
        return
    author_channel_id = row.get("author_channel_id")
    comment_id = row.get("comment_id")
    if not comment_id or not author_channel_id:
        await interaction.response.send_message("Conclua primeiro **Etapa 1: comentário**. Ainda não tenho um canal associado ao seu código.", ephemeral=True)
        return
    last_checked = row.get("subscriber_checked_at")
    if last_checked:
        try:
            elapsed = (utc_now() - datetime.fromisoformat(last_checked)).total_seconds()
            if elapsed < VERIFY_COOLDOWN_SECONDS:
                await interaction.response.send_message(f"Aguarde {int(VERIFY_COOLDOWN_SECONDS - elapsed)} segundos antes de consultar a lista novamente.", ephemeral=True)
                return
        except ValueError:
            pass
    with db_connect() as conn:
        conn.execute(
            "UPDATE comment_codes SET subscriber_checked_at=? WHERE guild_id=? AND user_id=? AND used_at IS NULL",
            (now_iso(), interaction.guild.id, interaction.user.id),
        )
    await interaction.response.defer(ephemeral=True, thinking=True)
    try:
        live_comment = await asyncio.to_thread(
            find_public_comment_by_id, row["video_id"], comment_id, row["code"]
        )
        if not live_comment or live_comment.get("comment_id") != comment_id or live_comment.get("author_channel_id") != author_channel_id:
            with db_connect() as conn:
                conn.execute(
                    "UPDATE comment_codes SET comment_id=NULL,author_channel_id=NULL,author_display_name=NULL WHERE guild_id=? AND user_id=? AND code=? AND used_at IS NULL",
                    (interaction.guild.id, interaction.user.id, row["code"]),
                )
            await interaction.followup.send(
                "Não consegui confirmar que o comentário original ainda está público e inalterado. O código não foi consumido nem o cargo liberado. Publique-o novamente se necessário e refaça **Etapa 1: comentário**.",
                ephemeral=True,
            )
            return
        owner_channel_id = await asyncio.to_thread(get_video_owner_channel_id, interaction.guild.id)
        subscriber_ids, pages, truncated = await asyncio.to_thread(fetch_visible_subscriber_ids, owner_channel_id)
    except RuntimeError as exc:
        await interaction.followup.send(str(exc), ephemeral=True)
        return
    if author_channel_id not in subscriber_ids:
        tail = "A lista chegou ao limite de 1.000 resultados." if truncated else "O YouTube não retornou esse canal na lista visível."
        await interaction.followup.send(
            f"**Etapa 1/2 concluída:** o comentário veio do canal `{author_channel_id}`. **Não consegui confirmar a inscrição** ({tail}).\n"
            "Inscrições privadas não aparecem para o bot. Seu código continua ativo e não foi consumido; se já está inscrito, confira se a inscrição está pública e tente a Etapa 2 novamente depois.",
            ephemeral=True,
        )
        return

    now = utc_now()
    claimed = False
    found = {"comment_id": comment_id, "author_channel_id": author_channel_id, "author_display_name": row.get("author_display_name")}
    try:
        with db_connect() as conn:
            conn.execute("BEGIN IMMEDIATE")
            current = conn.execute("SELECT * FROM comment_codes WHERE guild_id=? AND user_id=?", (interaction.guild.id, interaction.user.id)).fetchone()
            current_expiry = datetime.fromisoformat(current["expires_at"]) if current else now
            if current_expiry.tzinfo is None:
                current_expiry = current_expiry.replace(tzinfo=timezone.utc)
            if (
                not current or current["used_at"] or current["code"] != row["code"] or current["video_id"] != settings["video_id"]
                or current["comment_id"] != comment_id or current["author_channel_id"] != author_channel_id or current_expiry <= now
            ):
                raise RuntimeError("O código expirou ou mudou durante a consulta. Gere outro pelo painel e repita as duas etapas.")
            if not test_mode:
                linked_elsewhere = conn.execute(
                    "SELECT 1 FROM verification_history WHERE guild_id=? AND author_channel_id=? AND user_id!=? LIMIT 1",
                    (interaction.guild.id, author_channel_id, interaction.user.id),
                ).fetchone()
                if linked_elsewhere:
                    raise sqlite3.IntegrityError("YouTube channel already linked to another Discord account")
            changed = conn.execute(
                "UPDATE comment_codes SET used_at=? WHERE guild_id=? AND user_id=? AND used_at IS NULL",
                (now.isoformat(), interaction.guild.id, interaction.user.id),
            ).rowcount
            if not changed:
                raise RuntimeError("Esse código já foi consumido por outra tentativa. Gere outro ou fale com a staff.")
            if test_mode:
                conn.execute(
                    "INSERT INTO test_verifications(guild_id,user_id,video_id,comment_id,author_channel_id,author_display_name,verified_at) VALUES(?,?,?,?,?,?,?)",
                    (interaction.guild.id, interaction.user.id, settings["video_id"], comment_id, author_channel_id, row.get("author_display_name"), now.isoformat()),
                )
            else:
                conn.execute(
                    "INSERT INTO verification_history(guild_id,user_id,video_id,comment_id,author_channel_id,author_display_name,verified_at) VALUES(?,?,?,?,?,?,?)",
                    (interaction.guild.id, interaction.user.id, settings["video_id"], comment_id, author_channel_id, row.get("author_display_name"), now.isoformat()),
                )
                conn.execute(
                    """INSERT INTO verifications(guild_id,user_id,video_id,comment_id,author_channel_id,author_display_name,verified_at)
                    VALUES(?,?,?,?,?,?,?)
                    ON CONFLICT(guild_id,user_id) DO UPDATE SET video_id=excluded.video_id,comment_id=excluded.comment_id,
                    author_channel_id=excluded.author_channel_id,author_display_name=excluded.author_display_name,verified_at=excluded.verified_at""",
                    (interaction.guild.id, interaction.user.id, settings["video_id"], comment_id, author_channel_id, row.get("author_display_name"), now.isoformat()),
                )
            claimed = True
    except sqlite3.IntegrityError:
        await interaction.followup.send("Esse canal ou comentário já está vinculado a outra conta Discord neste servidor.", ephemeral=True)
        return
    except RuntimeError as exc:
        await interaction.followup.send(str(exc), ephemeral=True)
        return

    try:
        await interaction.user.add_roles(role, reason="Comentário confirmado e canal encontrado entre os inscritos visíveis do proprietário do vídeo")
    except (discord.Forbidden, discord.HTTPException):
        if claimed:
            with db_connect() as conn:
                conn.execute("UPDATE comment_codes SET used_at=NULL WHERE guild_id=? AND user_id=? AND comment_id=?", (interaction.guild.id, interaction.user.id, comment_id))
                if test_mode:
                    conn.execute("DELETE FROM test_verifications WHERE guild_id=? AND user_id=? AND comment_id=?", (interaction.guild.id, interaction.user.id, comment_id))
                else:
                    conn.execute("DELETE FROM verifications WHERE guild_id=? AND user_id=? AND comment_id=?", (interaction.guild.id, interaction.user.id, comment_id))
                    conn.execute("DELETE FROM verification_history WHERE guild_id=? AND user_id=? AND comment_id=?", (interaction.guild.id, interaction.user.id, comment_id))
        await interaction.followup.send("As duas etapas passaram, mas não consegui atribuir o cargo. Avise a staff para conferir permissões/hierarquia; seu comentário continua registrado e você pode tentar a Etapa 2 novamente.", ephemeral=True)
        return

    audit(interaction.guild.id, interaction.user.id, "TEST_COMMENT_AND_SUBSCRIPTION_VERIFIED" if test_mode else "COMMENT_AND_SUBSCRIPTION_VERIFIED", comment_id)
    if settings.get("notify_on_verify") and not test_mode:
        await send_member_notification(interaction.guild, interaction.user, "verify", role, found)
    prefix = "**Verificação de teste concluída!**" if test_mode else "**Verificação concluída!**"
    author_name = discord.utils.escape_markdown(row.get("author_display_name") or "Nome público indisponível")
    author_value = f"[{author_name}](https://www.youtube.com/channel/{author_channel_id}) · ID `{author_channel_id}`"
    await interaction.followup.send(
        f"{prefix} As duas etapas passaram, você recebeu/confirmou {role.mention} e seu canal foi vinculado a esta conta Discord.\nCanal vinculado: {author_value}.",
        ephemeral=True,
        allowed_mentions=discord.AllowedMentions.none(),
    )
    try:
        title = "Verificação de teste concluída" if test_mode else "Verificação concluída"
        await interaction.user.send(
            embed=audit_embed(
                title,
                f"As duas etapas passaram e você recebeu/confirmou o cargo **{discord.utils.escape_markdown(role.name)}** no servidor **{discord.utils.escape_markdown(interaction.guild.name)}**.\n\nCanal vinculado: **{author_name}** (`{author_channel_id}`).",
                discord.Color.green(),
            ),
            allowed_mentions=discord.AllowedMentions.none(),
        )
    except (discord.Forbidden, discord.HTTPException):
        pass


