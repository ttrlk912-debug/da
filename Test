local function ensureDir(path)
    if not doesDirectoryExist(path) then
        createDirectory(path)
    end
end

-- Lista os arquivos de uma pasta cujo nome bate com o padrão (ex: '%.png$').
-- Igual ao getListOfSounds() do GameFixer: chama lfs.dir direto, sem checar
-- doesDirectoryExist antes (esse checador às vezes não bate com o caminho
-- relativo do jeito que o lfs reconhece, e a lista ficava sempre vazia).
local function listFiles(dir, extPattern)
    local files = {}
    pcall(function()
        for file in lfs.dir(dir) do
            if file ~= '.' and file ~= '..' and file:lower():match(extPattern) then
                table.insert(files, file)
            end
        end
    end)
    table.sort(files)
    return files
end

-- Padrão do texto que identifica um acerto SEU no chat (dano causado, não recebido).
--
-- Confirmado com o log real do seu servidor:
--   Você acerta:  "-DamageInformer- Você fez 1 de dano em ID 234068 com Soco..."
--   Você leva:    "-DamageInformer- ID 234068 fez 1 de dano com Soco..."
--
-- Em vez de procurar a palavra "Você" (acento pode vir com encoding diferente
-- no SA:MP e quebrar a comparação), a gente identifica pelo formato: se logo
-- depois de "DamageInformer- " vem "ID <número> fez", é dano QUE VOCÊ LEVOU
-- -> ignora. Qualquer outra mensagem com "DamageInformer" + "fez" é dano que
-- você causou -> dispara o hitmarker. Isso funciona independente de acento.
local HIT_RECEIVED_PATTERN = 'DamageInformer%-%s*ID %d+ fez'

-- Ative para ver no chat o texto bruto de cada mensagem recebida (debug).
