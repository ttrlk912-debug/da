function _addLog(text, result)
   table.insert(_log_data, (result and "{64FF64}" or "{FF6464}").."["..os.date("%H:%M:%S", os.time()).."] ["..(result and "DONE" or "SKIP").."] > "..text)
end

function _getCamMode()
   local aimptr = allocateMemory(31)
   local result, pid = sampGetPlayerIdByCharHandle(PLAYER_PED)
   if result then
      sampStorePlayerAimData(pid, aimptr)
      local mode = memory.getuint8(aimptr, 0)
      freeMemory(aimptr)
      return mode
   end
   return 0
end

function _getBodyPart(id, handle)
   local pedptr = getCharPointer(handle)
   local vec = ffi.new("float[3]")
   getBonePosition(ffi.cast("void*", pedptr), vec, id, true)
   return vector3d(vec[0], vec[1], vec[2])
end

function _getSightPos()
   if getCurrentCharWeapon(PLAYER_PED) == 34 then
      local x, y = getScreenResolution()
      return { x = x/2, y = y/2 }
   else
      local x, y = convertGameScreenCoordsToWindowScreenCoords(339.1, 179.1)
      return { x = x, y = y }
   end
end

function _getWeapon()
   return _weapons[getCurrentCharWeapon(PLAYER_PED)]
end

function _getRandomBone()
   local temp = {}
   for key, bone in ipairs(_config.bones) do
      if bone then table.insert(temp, key) end
   end
   if #temp > 0 then
      local idx = temp[math.random(1, #temp)]
      return idx
   end
   return 1
end

function _isTableHasValue(t, v)
   for _, val in ipairs(t) do if val == v then return true end end
   return false
end

function _tryInsert(t, v)
   if not _isTableHasValue(t, v) then table.insert(t, v) end
end

function _updateIP()
   local ip = sampGetCurrentServerAddress()
   if not _config.ignored[ip] then _config.ignored[ip] = { nicks = {}, skins = {} } end
   _ignored_nicks = _config.ignored[ip].nicks
   _ignored_skins = _config.ignored[ip].skins
end

function _writeWallshot()
   for _, addr in ipairs({ 0x00740701, 0x00740703, 0x00740709, 0x00740B49, 0x00740B4B, 0x00740B51, 0x0073620D, 0x0073620F, 0x00736215 }) do
      memory.write(addr, _config.wallshot and 0 or 1, 1, true)
   end
end

function _vector2d(x, y) return { x = x, y = y } end

-- ============================================================
--  MAIN LOOP
-- ============================================================
function main()
   if not isSampLoaded() or not isSampfuncsLoaded() then return end
   repeat wait(100) until isSampAvailable()

   _updateIP()
   _writeWallshot()
   
   addEventHandler("onWindowMessage", _windowMsgHandler)
   addEventHandler("onScriptTerminate", _scriptTerminateHandler)

   local last_bone_upd = os.clock()
   local _pref_bone_idx = imgui.new.int(_getRandomBone())

   if _config.initmsg then sampAddChatMessage("{FF66CC}[Silent Aim Ultimate]{FFFFFF} v3.0 Loaded. Press /sys to open.", -1) end

   while true do
      _legit = nil
      if not sampIsChatInputActive() and not isSampfuncsConsoleActive() and not sampIsDialogActive() then
         if isKeyJustPressed(_config.menubutton) then menu_anim.toggle() end
         if not _config.lockactive and isKeyJustPressed(_config.statebutton) then _state[0] = not _state[0] end
         if _config.lockactive then _state[0] = isKeyDown(_config.lockbutton) end
      end

      if _state[0] then
         local weapon = _getWeapon()
         if weapon then
            if os.clock() - last_bone_upd >= _pref_bone_upd[0] and (isButtonPressed(player, 0) or isButtonPressed(player, 1)) then
               last_bone_upd = os.clock()
               _pref_bone_idx[0] = _getRandomBone()
            end

            local sight_2d = _getSightPos()
            local sight_3d = vector3d(convertScreenCoordsToWorld3D(sight_2d.x, sight_2d.y, 1))
            local tdist = (_config.indivfov and _config.guns[weapon.name].fov or _config.fov) * 10

            local temp_bones = {}
            local sel_bone_dots = _bones[_pref_bone_idx[0]].dots
            for _, dot in ipairs(sel_bone_dots) do table.insert(temp_bones, dot) end
            
            for k, bone in ipairs(_bones) do
               if k ~= _pref_bone_idx[0] then
                  for _, dot in ipairs(bone.dots) do table.insert(temp_bones, dot) end
               end
            end

            for _, ped in ipairs(getAllChars()) do
               if ped ~= PLAYER_PED and isCharOnScreen(ped) then
                  local result, id = sampGetPlayerIdByCharHandle(ped)
                  if result then
                     if _config.ignorebynick and _isTableHasValue(_ignored_nicks, sampGetPlayerNickname(id)) then goto next_ped end
                     if _config.ignorebyskin and _isTableHasValue(_ignored_skins, getCharModel(ped)) then goto next_ped end
                     if _config.ignoremyclist and sampGetPlayerColor(id) == sampGetPlayerColor(select(2, sampGetPlayerIdByCharHandle(PLAYER_PED))) then goto next_ped end

                     for _, bone_id in ipairs(temp_bones) do
                        local peds_bone = _getBodyPart(bone_id, ped)
                        local bone_2d = _vector2d(convert3DCoordsToScreen(peds_bone:get()))
                        local dist_sight = getDistanceBetweenCoords2d(bone_2d.x, bone_2d.y, sight_2d.x, sight_2d.y) 
                        local dist = getDistanceBetweenCoords3d(sight_3d.x, sight_3d.y, sight_3d.z, peds_bone:get())
                        
                        if dist_sight < tdist and dist < weapon.dist and (not _legit or _legit.dist_sight > dist_sight) and not isCharDead(ped) and not sampIsPlayerPaused(id) then
                           if isLineOfSightClear(sight_3d.x, sight_3d.y, sight_3d.z, peds_bone.x, peds_bone.y, peds_bone.z, not _config.ignoreobj, not _config.ignoreveh, false, not _config.ignoreobj, false) then
                              _legit = { dist = dist, dist_sight = dist_sight, id = id, bone = peds_bone, bone_num = bone_id }
                              break
                           end
                        end
                     end
                  end
               end
               ::next_ped::
            end
            
            if _legit and _config.debug then
               local tar_2d = _vector2d(convert3DCoordsToScreen(_legit.bone:get()))
               renderDrawLine(sight_2d.x, sight_2d.y, tar_2d.x, tar_2d.y, 1, 0xFFFF00FF)
               renderDrawBox(tar_2d.x-2, tar_2d.y-2, 5, 5, 0xFFFF00FF)
            end
         end
      end
      wait(0)
   end
end

