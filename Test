                imgui.TextColored(last_load_status.ok and COL_TEXT_OK or COL_TEXT_BAD, last_load_status.msg)
            end

            imgui.Spacing()

            beginCard("##card_pos", 155)
            imgui.TextColored(COL_TEXT_MUTED, "POSICAO  /  TAMANHO  /  DURACAO")
