@bot.event
async def on_ready():
    if not getattr(bot, "_persistent_views_registered", False):
        bot.add_view(PlayerPanelView())
        for staff_page in StaffPanelTabSelect.PAGES:
            bot.add_view(StaffPanelView(staff_page[0]))
        bot._persistent_views_registered = True
    try:
        synced = await bot.tree.sync()
        logger.info("Comandos de aplicação sincronizados: %d", len(synced))
    except discord.HTTPException:
        logger.exception("Falha ao sincronizar comandos do Discord")
    for guild in bot.guilds:
        settings = get_settings(guild.id)
        if not settings.get("reward_role_id"):
            old_role = discord.utils.get(guild.roles, name="Inscrito")
            if old_role and not old_role.managed:
                update_settings(guild.id, reward_role_id=old_role.id)
                audit(guild.id, None, "LEGACY_REWARD_ROLE_IMPORTED", str(old_role.id))
                logger.info("Cargo legado de recompensa reconhecido no servidor %s.", guild.id)
    if not getattr(bot, "_player_panels_refreshed", False):
        for guild in bot.guilds:
            settings = get_settings(guild.id)
            if not settings.get("player_channel_id"):
                continue
            try:
                await publish_player_panel(guild)
            except (RuntimeError, discord.Forbidden, discord.HTTPException):
                logger.warning("Não consegui atualizar o painel público no servidor %s ao iniciar.", guild.id)
        bot._player_panels_refreshed = True
    logger.info("Bot conectado como %s; banco local: %s", bot.user, DB_PATH)


