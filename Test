            imgui.Spacing()

            beginCard("##card_testkey", 140)
            imgui.TextColored(COL_PURPLE_ACTIVE, "TECLA DE TESTE")
            imgui.Spacing()

            if toggleButton("Ativar tecla de teste", test_enabled, "test_enabled") then
