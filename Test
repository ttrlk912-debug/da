            imgui.Spacing()
            if primaryButton("TESTAR HITMARKER AGORA", imgui.ImVec2(-1, 40)) then
                triggerHitmarker()
                pushToast("Hitmarker testado", true)
            end
        end

        imgui.EndChild() -- ##hm_content
        imgui.End()

        imgui.PopStyleColor(14)
        if styleVarPushed > 0 then
            pcall(function() imgui.PopStyleVar(styleVarPushed) end)
        end
    end -- if menu_open.v

    -- ============================================================
    -- TOASTS
    -- ============================================================
    if #toasts > 0 then
        local toastY = 20
        for i, t in ipairs(toasts) do
            local alpha = 1.0
            local remaining = t.expire - os.clock()
            if remaining < 0.6 then
                alpha = math.max(0.0, remaining / 0.6)
            end

            local bgCol = t.ok
                and imgui.ImVec4(0.10, 0.18, 0.14, 0.92 * alpha)
                or  imgui.ImVec4(0.26, 0.10, 0.12, 0.92 * alpha)

            local textCol = t.ok
                and imgui.ImVec4(0.70, 1.00, 0.78, alpha)
                or  imgui.ImVec4(1.00, 0.70, 0.72, alpha)

            imgui.SetNextWindowPos(imgui.ImVec2(sw - 320, toastY), imgui.Cond.Always)
            imgui.SetNextWindowSize(imgui.ImVec2(300, 48), imgui.Cond.Always)

            imgui.PushStyleColor(imgui.Col.WindowBg, bgCol)
            imgui.PushStyleColor(imgui.Col.Text, textCol)

            local flags = imgui.WindowFlags.NoTitleBar
                + imgui.WindowFlags.NoResize
                + imgui.WindowFlags.NoMove
                + imgui.WindowFlags.NoScrollbar
                + imgui.WindowFlags.NoCollapse

            imgui.Begin("##toast_" .. i, nil, flags)
            local prefix = t.ok and "[OK]  " or "[X]  "
            imgui.Text(prefix .. t.text)
            imgui.End()

            imgui.PopStyleColor(2)
            toastY = toastY + 56
        end
    end
end

-- Desenha o hitmarker na posição/tamanho configurados enquanto estiver ativo
addEventHandler('onD3DPresent', function()
    if texture and os.clock() < showUntil then
        local size = ini.MARKER.SIZE
        local x = sw / 2 - size / 2 + ini.MARKER.X
        local y = sh / 2 - size / 2 + ini.MARKER.Y
        renderDrawTexture(texture, x, y, size, size, 0.0, 0xFFFFFFFF)
    end
end)

-- Para todos os sons ao descarregar o script
function onScriptTerminate(script)
    if script == thisScript() then
        stopMusic()
        if audio then pcall(setAudioStreamState, audio, 0) end
        if pain_audio then pcall(setAudioStreamState, pain_audio, 0) end
    end
end
