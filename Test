        ----------------------------------------------------------------
        -- ABA 2: SONS
        ----------------------------------------------------------------
        elseif current_tab == 2 then
            sectionTitle("SONS", "Sons de acerto e de dano recebido")

            beginCard("##card_hit_sound", 205)
            imgui.TextColored(COL_PURPLE_ACTIVE, "QUANDO VOCE ACERTA")
            imgui.Spacing()

            if toggleButton("Som de acerto", sound_enabled, "sound_enabled") then
                ini.MARKER.SOUND_ENABLED = sound_enabled.v
                saveConfig()
                pushToast(sound_enabled.v and "Som de acerto: ON" or "Som de acerto: OFF", true)
            end

            if ini.MARKER.SOUND_ENABLED then
                imgui.Spacing()
                ini.MARKER.SOUND_VOLUME = valueStepper("Volume", ini.MARKER.SOUND_VOLUME, "soundvol", 0, 100, 5)
