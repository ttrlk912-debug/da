            ini.MARKER.Y = valueStepper("Posicao Y", ini.MARKER.Y, "y", -400, 400, 5)
            ini.MARKER.SIZE = valueStepper("Tamanho", ini.MARKER.SIZE, "size", 8, 256, 4)
            ini.MARKER.DURATION = valueStepper("Duracao (ms)", ini.MARKER.DURATION, "duration", 50, 2000, 50)
