class VerifiedMemberModal(discord.ui.Modal):
    user_id = discord.ui.TextInput(label="ID do membro do Discord", placeholder="Cole o ID da pessoa que deseja consultar", min_length=15, max_length=22)
    reason = discord.ui.TextInput(label="Motivo (opcional)", placeholder="Fica registrado apenas para a staff", required=False, max_length=250)

    def __init__(self, action: str):
        self.action = action if action in {"lookup", "grant", "revoke"} else "lookup"
        titles = {"lookup": "Consultar verificação", "grant": "Adicionar verificado", "revoke": "Remover verificado"}
        super().__init__(title=titles[self.action])

    async def on_submit(self, interaction: discord.Interaction):
        if not interaction.guild or not isinstance(interaction.user, discord.Member) or not is_staff(interaction.user):
            await interaction.response.send_message("Somente a staff pode consultar ou alterar verificações.", ephemeral=True)
            return
        await interaction.response.defer(ephemeral=True, thinking=True)
        try:
            member = await resolve_guild_member(interaction.guild, self.user_id.value)
        except RuntimeError as exc:
            await interaction.followup.send(str(exc), ephemeral=True)
            return
        if member is None or member.bot:
            await interaction.followup.send("Não encontrei uma conta de pessoa válida neste servidor.", ephemeral=True)
            return

        settings = get_settings(interaction.guild.id)
        reward_role = interaction.guild.get_role(int(settings["reward_role_id"])) if settings.get("reward_role_id") else None
        if self.action != "lookup":
            if reward_role is None or reward_role.managed:
                await interaction.followup.send("O cargo de verificação não está configurado ou não pode ser gerenciado.", ephemeral=True)
                return
            if self.action == "grant" and get_blacklist_entry(interaction.guild.id, member.id):
                await interaction.followup.send("A conta está na blacklist. Remova o bloqueio antes de conceder o cargo de verificação.", ephemeral=True)
                return
            bot_member = interaction.guild.me
            if bot_member is None or not bot_member.guild_permissions.manage_roles or reward_role >= bot_member.top_role:
                await interaction.followup.send("Não consigo gerenciar esse cargo. Confira **Gerenciar cargos** e a hierarquia do bot.", ephemeral=True)
                return
            reason = self.reason.value.strip()[:250]
            try:
                if self.action == "grant" and reward_role not in member.roles:
                    await member.add_roles(reward_role, reason=f"Concedido manualmente por staff {interaction.user.id}")
                elif self.action == "revoke" and reward_role in member.roles:
                    await member.remove_roles(reward_role, reason=f"Revogado manualmente por staff {interaction.user.id}")
            except discord.Forbidden:
                await interaction.followup.send("O Discord recusou a mudança do cargo. Confira as permissões e a hierarquia.", ephemeral=True)
                return
            except discord.HTTPException:
                await interaction.followup.send("O Discord não conseguiu atualizar o cargo agora. Tente novamente.", ephemeral=True)
                return
            action_value = "grant" if self.action == "grant" else "revoke"
            event_name = "MANUAL_VERIFICATION_GRANTED" if self.action == "grant" else "MANUAL_VERIFICATION_REVOKED"
            with db_connect() as conn:
                conn.execute(
                    "INSERT INTO manual_verification_actions(guild_id,user_id,actor_id,action,reason,created_at) VALUES(?,?,?,?,?,?)",
                    (interaction.guild.id, member.id, interaction.user.id, action_value, reason, now_iso()),
                )
                if self.action == "revoke":
                    conn.execute(
                        "DELETE FROM verifications WHERE guild_id=? AND user_id=?",
                        (interaction.guild.id, member.id),
                    )
                    conn.execute(
                        "DELETE FROM comment_codes WHERE guild_id=? AND user_id=?",
                        (interaction.guild.id, member.id),
                    )
            audit(interaction.guild.id, interaction.user.id, event_name, f"user={member.id};reason={reason}")

        youtube_record, manual_record = get_verification_status(interaction.guild.id, member.id)
        has_reward_role = bool(reward_role and reward_role in member.roles)
        embed = discord.Embed(title="Status de verificação", color=discord.Color.blurple())
        embed.add_field(name="Membro", value=f"{member.mention}\n`{member.id}`", inline=False)
        embed.add_field(name="Cargo verificado", value="Sim" if has_reward_role else "Não", inline=True)
        if youtube_record:
            youtube_value = f"Comentário validado pelo bot em <t:{int(datetime.fromisoformat(youtube_record['verified_at']).replace(tzinfo=timezone.utc).timestamp())}:f>\nVídeo: `{youtube_record['video_id']}`"
        else:
            youtube_value = "Nenhum registro de comentário confirmado pelo bot."
        if youtube_record:
            channel_name = discord.utils.escape_markdown(youtube_record.get("author_display_name") or "Nome público indisponível")
            channel_id = youtube_record.get("author_channel_id")
            if channel_id:
                channel_value = f"[{channel_name}](https://www.youtube.com/channel/{channel_id})\nID do canal: `{channel_id}`"
            else:
                channel_value = channel_name
            embed.add_field(name="Canal que comentou", value=channel_value, inline=False)
        embed.add_field(name="Registro ativo do YouTube", value=youtube_value, inline=False)
        if manual_record:
            action_label = "Cargo concedido manualmente" if manual_record["action"] == "grant" else "Cargo removido manualmente"
            manual_value = f"{action_label} <t:{int(datetime.fromisoformat(manual_record['created_at']).replace(tzinfo=timezone.utc).timestamp())}:R> por <@{manual_record['actor_id']}>"
            if manual_record.get("reason"):
                manual_value += f"\n**Motivo:** {discord.utils.escape_markdown(manual_record['reason'])}"
        else:
            manual_value = "Sem ações manuais registradas."
        embed.add_field(name="Última ação da staff", value=manual_value, inline=False)
        if self.action == "grant":
            embed.description = "Cargo aplicado pela staff. Isso não cria nem altera uma comprovação de comentário do YouTube."
        elif self.action == "revoke":
            embed.description = "Cargo retirado e registro ativo de verificação/códigos removidos. A pessoa só poderá verificar novamente depois deste reset da staff; o arquivo histórico e a auditoria permanecem preservados."
        await interaction.followup.send(embed=embed, ephemeral=True, allowed_mentions=discord.AllowedMentions.none())


