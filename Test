-- Buffers ImInt para edição direta dos números (criados sob demanda)
local int_bufs = {}

local function getIntBuf(id, value)
    if not int_bufs[id] then
        int_bufs[id] = imgui.ImInt(value)
    end
    return int_bufs[id]
end

-- Stepper de valor com campo editável (clica no número e digita)
-- Layout:  [ - ]  [  45  ]  [ + ]
local function valueStepper(label, value, id, minValue, maxValue, step)
    imgui.TextColored(COL_TEXT_MUTED, label)
    imgui.SameLine(200)

    local buf = getIntBuf(id, value)

    imgui.PushStyleColor(imgui.Col.Button, COL_BTN)
    imgui.PushStyleColor(imgui.Col.ButtonHovered, COL_BTN_HOVER)
    imgui.PushStyleColor(imgui.Col.ButtonActive, COL_BTN_ACTIVE)
    imgui.PushStyleColor(imgui.Col.FrameBg, COL_BG_CARD)
    imgui.PushStyleColor(imgui.Col.FrameBgHovered, COL_BG_HOVER)
    imgui.PushStyleColor(imgui.Col.FrameBgActive, COL_PURPLE_DIM)

    -- botão -
    if imgui.Button(" - ##" .. id .. "d", imgui.ImVec2(32, 26)) then
        value = math.max(minValue, value - step)
        buf.v = value
        saveConfig()
        pushToast(label .. ': ' .. tostring(value), true)
    end
    imgui.SameLine()

    -- campo editável: clica e digita (ex: -1, 20, 450)
    imgui.PushItemWidth(72)
    -- step/step_fast = 0 desativa as setinhas internas do InputInt
    if imgui.InputInt("##" .. id .. "in", buf, 0, 0) then
        local v = buf.v
        if v < minValue then v = minValue end
        if v > maxValue then v = maxValue end
        buf.v = v
        value = v
        saveConfig()
        -- sem toast a cada tecla para não poluir
    end
    imgui.PopItemWidth()
    imgui.SameLine()

    -- botão +
    if imgui.Button(" + ##" .. id .. "i", imgui.ImVec2(32, 26)) then
        value = math.min(maxValue, value + step)
        buf.v = value
        saveConfig()
        pushToast(label .. ': ' .. tostring(value), true)
    end

    imgui.PopStyleColor(6)
    return value
end

-- Título de seção
local function sectionTitle(title, subtitle)
    imgui.TextColored(COL_PURPLE_ACTIVE, title)
    if subtitle then
        imgui.TextColored(COL_TEXT_MUTED, subtitle)
    end
    imgui.Spacing()
end

-- Card visual (BeginChild simples, sem bordas pesadas)
local function beginCard(id, height)
    imgui.BeginChild(id, imgui.ImVec2(0, height), true)
end

local function endCard()
    imgui.EndChild()
end

-- Lista de arquivos
local function fileList(id, height, files, selectedPath, basePath, emptyText, onSelect)
    imgui.BeginChild(id, imgui.ImVec2(0, height), true)
    if #files == 0 then
        imgui.TextColored(COL_TEXT_MUTED, emptyText)
    else
        for _, filename in ipairs(files) do
            local selected = selectedPath == basePath .. filename
            if selected then
                imgui.PushStyleColor(imgui.Col.Header, COL_PURPLE_DIM)
                imgui.PushStyleColor(imgui.Col.HeaderHovered, COL_PURPLE_SOFT)
                imgui.PushStyleColor(imgui.Col.HeaderActive, COL_PURPLE)
            end
            if imgui.Selectable("  " .. filename .. "##" .. id .. filename, selected) then
                onSelect(filename)
            end
            if selected then
                imgui.PopStyleColor(3)
            end
        end
    end
    imgui.EndChild()
end

