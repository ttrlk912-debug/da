class RoleModal(discord.ui.Modal, title="Configurar cargo de recompensa"):
    role_id = discord.ui.TextInput(label="ID do cargo de recompensa", placeholder="Ative o modo desenvolvedor e copie o ID do cargo", max_length=25)
    role_name = discord.ui.TextInput(label="Novo nome (opcional)", placeholder="Deixe em branco para manter o nome", required=False, max_length=100)

    async def on_submit(self, interaction: discord.Interaction):
        if not interaction.guild or not is_staff(interaction.user):
            await interaction.response.send_message("Somente a staff pode alterar essa configuração.", ephemeral=True)
            return
        try:
            role = interaction.guild.get_role(int(self.role_id.value.strip()))
        except (ValueError, TypeError):
            role = None
        if role is None or role.is_default() or role.managed:
            await interaction.response.send_message("ID inválido: escolha um cargo normal deste servidor.", ephemeral=True)
            return
        settings = get_settings(interaction.guild.id)
        if settings.get("join_role_id") and int(settings["join_role_id"]) == role.id:
            await interaction.response.send_message("Esse cargo está configurado para novos membros. Escolha um cargo diferente para a recompensa de comentário.", ephemeral=True)
            return
        bot_member = interaction.guild.me
        if bot_member is None or role >= bot_member.top_role:
            await interaction.response.send_message("O cargo do bot precisa estar acima do cargo de recompensa na hierarquia.", ephemeral=True)
            return
        new_name = self.role_name.value.strip()
        if new_name and new_name != role.name:
            try:
                await role.edit(name=new_name, reason=f"Cargo de verificação configurado por {interaction.user.id}")
            except discord.Forbidden:
                await interaction.response.send_message("Não consegui renomear o cargo. Confira Gerenciar cargos e a hierarquia do bot.", ephemeral=True)
                return
            except discord.HTTPException:
                await interaction.response.send_message("O Discord não conseguiu renomear o cargo agora.", ephemeral=True)
                return
        update_settings(interaction.guild.id, reward_role_id=role.id)
        audit(interaction.guild.id, interaction.user.id, "REWARD_ROLE_CONFIGURED", str(role.id))
        await interaction.response.send_message(embed=audit_embed("Cargo configurado", f"O cargo {role.mention} será atribuído após a confirmação do comentário.", discord.Color.green()), ephemeral=True, allowed_mentions=discord.AllowedMentions.none())


