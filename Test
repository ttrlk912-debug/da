         if os.clock() - last_bone_upd >= _pref_bone_upd[0] and (isButtonPressed(player, 0) or isButtonPressed(player, 1)) then last_bone_upd = os.clock() _pref_bone[0] = _getRandomBone() end
         local sight_2d = _getSightPos() local sight_3d = vector3d(convertScreenCoordsToWorld3D(sight_2d.x, sight_2d.y, 1)) local tdist = (_config.indivfov and _config.guns[weapon.name].fov or _config.fov) * 10
