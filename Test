function _rgbToArgb(ptr, alpha)
   if not ptr then return 0xFFFFFFFF end
   local r = math.floor((ptr[0] or 1.0) * 255) local g = math.floor((ptr[1] or 1.0) * 255) local b = math.floor((ptr[2] or 1.0) * 255) local a = math.floor((alpha or 1.0) * 255)
   return bit.bor(bit.lshift(a, 24), bit.lshift(r, 16), bit.lshift(g, 8), b)
end
function _rgbToImVec4(ptr) if not ptr then return imgui.ImVec4(1, 1, 1, 1) end return imgui.ImVec4(ptr[0], ptr[1], ptr[2], 1.0) end

function _toggle(text, key)
   if not _toggle_anim[key] then _toggle_anim[key] = _config[key] and 1.0 or 0.0 end
   local w, h = 36, 18 local radius = h / 2 local target = _config[key] and 1.0 or 0.0
   _toggle_anim[key] = _toggle_anim[key] + (target - _toggle_anim[key]) * 0.25
   local t = _toggle_anim[key]
   local r = 0.25 + (0.35 - 0.25) * t local g = 0.25 + (0.75 - 0.25) * t local b = 0.30 + (0.40 - 0.30) * t local bg = imgui.ImVec4(r, g, b, 1.0)
   local start_pos = imgui.GetCursorScreenPos() local total_w = w + 8 + imgui.CalcTextSize(text).x
   imgui.Dummy(imgui.ImVec2(total_w, h)) imgui.SetCursorScreenPos(start_pos)
   local clicked = imgui.InvisibleButton("##tg_" .. key, imgui.ImVec2(w, h))
   imgui.SetCursorScreenPos(start_pos)
   local draw = imgui.GetWindowDrawList()
   draw:AddRectFilled(imgui.ImVec2(start_pos.x, start_pos.y), imgui.ImVec2(start_pos.x + w, start_pos.y + h), imgui.ColorConvertFloat4ToU32(bg), radius)
   local knob_x = start_pos.x + radius + (w - h) * t
   draw:AddCircleFilled(imgui.ImVec2(knob_x, start_pos.y + radius), radius - 2, imgui.ColorConvertFloat4ToU32(imgui.ImVec4(1.0, 1.0, 1.0, 1.0)))
   local text_y = start_pos.y + (h - imgui.GetTextLineHeight()) / 2
   imgui.SetCursorScreenPos(imgui.ImVec2(start_pos.x + w + 8, text_y)) imgui.Text(text)
   if clicked then _config[key] = not _config[key] end
   return clicked
end

