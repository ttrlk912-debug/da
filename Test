   end)
end

function _loadConfig()
   if not doesFileExist(_save_file) then return false end
   local f = io.open(_save_file, "r")
   if not f then return false end
   if _ignored_skins then for i = #_ignored_skins, 1, -1 do table.remove(_ignored_skins, i) end end
   if _ignored_nicks then for i = #_ignored_nicks, 1, -1 do table.remove(_ignored_nicks, i) end end
   for line in f:lines() do
      local key, value = line:match("^([^=]+)=(.+)$")
      if key and value then
         local real_name = _load_map[key]
         if real_name then
            if value == "true" then _config[real_name] = true
            elseif value == "false" then _config[real_name] = false
            else local num = tonumber(value) if num then _config[real_name] = num end end
         end
         local color_info = _color_map[key]
         if color_info then
            local ptr_name, idx = color_info[1], color_info[2]
            local num = tonumber(value)
            if num and _G[ptr_name] then _G[ptr_name][idx] = num end
         end
         if key == "pxr_01" then local num = tonumber(value) if num then _puxar_max_distance = num end end
         if key == "pxr_02" then _puxar_server_cmd = value end
         local skin_key = key:match("^sk_(%d+)$") if skin_key and _ignored_skins then table.insert(_ignored_skins, tonumber(value)) end
         local nick_key = key:match("^nk_(%d+)$") if nick_key and _ignored_nicks then table.insert(_ignored_nicks, value) end
      end
   end
   f:close()
   return true
end

