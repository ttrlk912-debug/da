function _puxar_refreshList()
   if not sampIsLocalPlayerSpawned() then
      _puxar_list = {}
      return
   end
   local px, py, pz = getCharCoordinates(PLAYER_PED)
   _puxar_list = _puxar_scanNearby(px, py, pz)
end

-- Executa a coleta de uma entrada específica da lista
function _puxar_executeFromList(entry)
   if _puxar_busy then return end
   if not sampIsLocalPlayerSpawned() then
      _puxar_status = "Entre no jogo primeiro"
      _puxar_status_color = 0xFFFF5555
      return
   end
   if isCharInAnyCar(PLAYER_PED) then
      _puxar_status = "Saia do veiculo primeiro"
      _puxar_status_color = 0xFFFF5555
      return
   end

   local x, y, z = getCharCoordinates(PLAYER_PED)

   _puxar_busy = true
   _puxar_status = string.format("Puxando %s (%.1fm)...", entry.name, entry.distance)
   _puxar_status_color = 0xFF66FF99

   lua_thread.create(function()
      local cameraLocked = false
      local function restore()
         pcall(setCharCoordinates, PLAYER_PED, x, y, z)
         pcall(freezeCharPosition, PLAYER_PED, false)
         pcall(setCharVisible, PLAYER_PED, true)
         if cameraLocked and type(restoreCameraJumpcut) == "function" then
            pcall(restoreCameraJumpcut)
         end
      end

      local ok = xpcall(function()
         if type(getActiveCameraCoordinates) == "function"
            and type(getActiveCameraPointAt) == "function"
            and type(setFixedCameraPosition) == "function"
            and type(pointCameraAtPoint) == "function" then
            local cx, cy, cz = getActiveCameraCoordinates()
            local lx, ly, lz = getActiveCameraPointAt()
            setFixedCameraPosition(cx, cy, cz, 0.0, 0.0, 0.0)
            pointCameraAtPoint(lx, ly, lz, 2)
            cameraLocked = true
         end

         setCharVisible(PLAYER_PED, false)
         freezeCharPosition(PLAYER_PED, true)
         setCharCoordinates(PLAYER_PED, entry.x, entry.y, entry.z + 0.15)
         wait(300)
         sampSendChat(_puxar_server_cmd)
         wait(450)
      end, debug.traceback)

      restore()
      _puxar_busy = false

      if ok then
         _puxar_status = entry.name.." coletada!"
         _puxar_status_color = 0xFF66FF99
      else
         _puxar_status = "Erro ao coletar"
         _puxar_status_color = 0xFFFF5555
      end
   end)
end

function _puxar_main()
   if _puxar_busy then
      _puxar_status = "Ja estou puxando..."
      _puxar_status_color = 0xFFFFAA33
      return
   end

   if not sampIsLocalPlayerSpawned() then
      _puxar_status = "Entre no jogo primeiro"
      _puxar_status_color = 0xFFFF5555
      return
   end

   if isCharInAnyCar(PLAYER_PED) then
      _puxar_status = "Saia do veiculo primeiro"
      _puxar_status_color = 0xFFFF5555
      return
   end

   _puxar_refreshList()

   if #_puxar_list == 0 then
      _puxar_status = string.format("Nenhuma arma em %.0fm", _puxar_max_distance)
      _puxar_status_color = 0xFFFFAA33
      return
   end

   _puxar_executeFromList(_puxar_list[1])
end



