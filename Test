   while true do
      _legit = nil
      if not sampIsChatInputActive() and not isSampfuncsConsoleActive() and not sampIsDialogActive() then
         local function _comboActive(btn1, btn2) if btn1 == 0 and btn2 == 0 then return false end if btn1 == 0 then return isKeyJustPressed(btn2) end if btn2 == 0 then return isKeyJustPressed(btn1) end return isKeyDown(btn1) and isKeyJustPressed(btn2) end
         if _comboActive(_config.menubutton, _config.combobutton) then if _window[0] then _saveConfig() end _window[0] = not _window[0] end
