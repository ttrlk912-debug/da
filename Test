      if _esp_color_name then f:write("clr_03a=".._esp_color_name[0].."\nclr_03b=".._esp_color_name[1].."\nclr_03c=".._esp_color_name[2].."\n") end
      if _esp_color_id then f:write("clr_04a=".._esp_color_id[0].."\nclr_04b=".._esp_color_id[1].."\nclr_04c=".._esp_color_id[2].."\n") end
