local fade_meta = {
    __index = function(self, key)
        if key == 'toggle' then
            return function()
                if self.thread and self.thread:status() ~= 'dead' then return false end
                self.timer = os.clock()
                self.state = not self.state
                self.thread = lua_thread.create(function()
                    while true do wait(0)
                        local t = os.clock() - self.timer
                        local ratio = (t >= 0 and t <= self.duration) and (t / self.duration) or (t > self.duration and 1.0 or 0.0)
                        self.alpha = self.state and ratio or (1.0 - ratio)
                        if ratio == 1.0 then break end
                    end
                end)
                return true
            end
        end
    end
}
local menu_anim = {state = false, duration = 0.4, alpha = 0.0}
setmetatable(menu_anim, fade_meta)

