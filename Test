-- SAMPEV
function sampev.onSendPlayerSync(data)
   if not _state[0] then return end

   local mode = _getCamMode()
   if _legit and (mode == 53 or mode == 7 or mode == 55) then
      _sendWeaponSync(_legit.id)
   else
      _sendWeaponSync(65535)
   end

   if not _legit then return end

   local weapon = _getWeapon()
   if not weapon then return end
   if weapon.id == 24 or weapon.id == 26 or weapon.id == 28 or weapon.id == 32 then return end

   if not isButtonPressed(player, 6) then mode = 4 end

   if not _config.syncrotation or (mode ~= 53 and mode ~= 7) or _legit.dist < _min_fake_dist[0] or _legit.dist > _max_fake_dist[0] then
      return
   end

   local my_bone = _getBodyPart(23, PLAYER_PED)
   local a = getHeadingFromVector2d(_legit.bone.x - my_bone.x, _legit.bone.y - my_bone.y) * math.pi / 360.0
   local c1, c2, c3 = math.cos(0), math.cos(a), math.cos(0)
   local s1, s2, s3 = math.sin(0), math.sin(a), math.sin(0)

   data.quaternion[0] = c1 * c2 * c3 - s1 * s2 * s3
   data.quaternion[3] = -(c1 * s2 * c3 - s1 * c2 * s3)
end

function _sendWeaponSync(id)
   if _last_target == id then return end
   local weapon = _getWeapon()
   if not weapon then return end

   local bs = raknetNewBitStream()
   raknetBitStreamWriteInt8(bs, 204)
   raknetBitStreamWriteInt16(bs, id)
   raknetBitStreamWriteInt16(bs, 65535)
   raknetBitStreamWriteInt8(bs, getWeapontypeSlot(weapon.id))
   raknetBitStreamWriteInt8(bs, weapon.id)
   raknetBitStreamWriteInt16(bs, getAmmoInCharWeapon(PLAYER_PED, weapon.id))
   raknetSendBitStream(bs)
   raknetDeleteBitStream(bs)

   _last_target = id
end

function sampev.onSendAimSync(data)
   if not _state[0] or not _legit or _legit.dist < _min_fake_dist[0] or _legit.dist > _max_fake_dist[0] then
      return true
   end

   local my_bone = _getBodyPart(23, PLAYER_PED)
   if _config.syncaimz then
      local d = _vector2d(
         getDistanceBetweenCoords3d(_legit.bone.x, _legit.bone.y, my_bone.z, my_bone:get()),
         getDistanceBetweenCoords3d(my_bone.x, my_bone.y, _legit.bone.z, my_bone:get())
      )
      local aimZ = math.atan(math.abs(d.y/d.x))
      data.aimZ = _legit.bone.z > my_bone.z and -aimZ or aimZ
   end

   if _config.cumbypass then
      data.camFront = vector3d(0.0, 0.0, -0.1)
      data.camPos = _legit.bone
   end
end

function sampev.onSendWeaponsUpdate(player_target, actor_target, weapons)
   if _config.faketarget and _legit and _config.maxfaketargetdist > _legit.dist then
      _last_target = _legit.id
      return { _legit.id, 65535, weapons }
   end
   if player_target == 65535 then _last_target = 65535 end
end

function sampev.onSendCameraTargetUpdate(object_id, vehicle_id, player_id, actor_id)
   if _config.faketarget and _legit then
      return { 65535, 65535, _legit.id, 65535 }
   end
end

function sampev.onSendCommand(cmd)
   if cmd == "/" .. _config.cmd then
      if _window[0] then _saveConfig() end
      _window[0] = not _window[0]
      return false
   end
end

function sampev.onSendBulletSync(data)
   if not _state[0] or not _legit or data.targetType == 1 or not doesCharExist(_legit.ped) then
      return true
   end

   local weapon = _getWeapon()
   if not weapon then return true end

   if not _config.fromthehip and not isCharInAnyCar(PLAYER_PED) and _getCamMode() == 4 then
      if _config.debug then _addLog("Skipped from hip with "..weapon.name, false) end
      return true
   end

   _shots = _shots + 1
   local missrate = _config.indivhit and _config.guns[weapon.name].hit or _hit_slider[0]

   if missrate < 100 then
      local rand = math.random(1, 100)
      if rand >= missrate then
         if _config.debug then _addLog("Skipped by random", false) end
         return true
      end
   end

   if _config.serialmisses then
      if _shots % (_miss_after[0] + 1) == 0 then
         if _config.debug then _addLog("Serial miss", false) end
         return true
      end
   end

   local ped_coords = vector3d(getCharCoordinates(_legit.ped))
   local my_coords = vector3d(getCharCoordinates(PLAYER_PED))

   if _legit.dist > weapon.dist or isCharDead(_legit.ped) or sampIsPlayerPaused(_legit.id) then
      if _config.debug then _addLog("Target invalid", false) end
      return true
   end

   local rand = vector3d(
      _randomFloat(_min_spread[0], _max_spread[0]),
      _randomFloat(_min_spread[0], _max_spread[0]),
      _randomFloat(_min_spread[0], _max_spread[0])
   )

   data.targetType = 1
   data.targetId = _legit.id
   data.target = ped_coords + rand
   data.center = _legit.bone - ped_coords + rand

   if _config.debug then
      lua_thread.create(function()
         local my_bone = _getBodyPart(26, PLAYER_PED)
         local target = vector3d(data.target.x + data.center.x, data.target.y + data.center.y, data.target.z + data.center.z)
         local time = os.clock()
         while _config.debug and os.clock() - time < 10.0 do
            if isPointOnScreen(my_bone.x, my_bone.y, my_bone.z, 0) and isPointOnScreen(target.x, target.y, target.z, 0) then
               local my_bone_2d = _vector2d(convert3DCoordsToScreen(my_bone:get()))
               local target_2d = _vector2d(convert3DCoordsToScreen(target:get()))
               renderDrawLine(my_bone_2d.x, my_bone_2d.y, target_2d.x, target_2d.y, 2, bit.bor(0xFF0000, bit.lshift(255 - (os.clock() - time) * 25.5, 24)))
               renderDrawPolygon(target_2d.x - 5, target_2d.y - 5, 10, 10, 20, 0, bit.bor(0x00FF00, bit.lshift(255 - (os.clock() - time) * 25.5, 24)))
            end
            wait(0)
         end
      end)
   end

   for bodypart, bone in ipairs(_bones) do
      for _, dot in ipairs(bone.dots) do
         if dot == _legit.bone_num then
            lua_thread.create(function()
               local id = _legit.id
               wait(1)
               sampSendGiveDamage(id, weapon.damage, weapon.id, bodypart + 2)
               if _config.debug then _addLog("Sent damage to "..id, true) end
            end)
            return
         end
      end
   end
end

function sampev.onSetPlayerPos()
   if _puxar_busy then
      pcall(freezeCharPosition, PLAYER_PED, false)
      pcall(setCharVisible, PLAYER_PED, true)
      if type(restoreCameraJumpcut) == "function" then
         pcall(restoreCameraJumpcut)
      end
      _puxar_busy = false
      _puxar_status = "Cancelado pelo servidor"
      _puxar_status_color = 0xFFFFAA33
   end
end



