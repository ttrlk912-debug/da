function TextColoredRGB(text)
   local explode_argb = function(argb) return bit.band(bit.rshift(argb, 24), 0xFF), bit.band(bit.rshift(argb, 16), 0xFF), bit.band(bit.rshift(argb, 8), 0xFF), bit.band(argb, 0xFF) end
   local getcolor = function(color) local color = type(color) == "string" and tonumber(color, 16) or color if type(color) ~= "number" then return nil end local r, g, b, a = explode_argb(color) return imgui.ImVec4(r / 255, g / 255, b / 255, a / 255) end
   for w in text:gmatch("[^\r\n]+") do
      local parts, colors_, m = {}, {}, 1 w = w:gsub("{(......)}", "{%1FF}")
      while w:find("{........}") do local n, k = w:find("{........}") local color = getcolor(w:sub(n + 1, k - 1)) if color then parts[#parts], parts[#parts + 1] = w:sub(m, n - 1), w:sub(k + 1, #w) colors_[#colors_ + 1] = color m = n end w = w:sub(1, n - 1) .. w:sub(k + 1, #w) end
      if parts[0] then for i = 0, #parts do imgui.TextColored(colors_[i] or imgui.ImVec4(1, 1, 1, 1), parts[i]) imgui.SameLine(nil, 0) end imgui.NewLine() else imgui.Text(w) end
   end
end

function _captureKey()
   if not _binding then return end
   for key = 1, 255 do
      local isDown = imgui.IsKeyDown(key) local wasDown = _last_key_state[key] or false
      if isDown and not wasDown then
         if key == 27 then _binding = nil
         elseif key == 8 then _config[_binding.key] = 0 _binding = nil
         else _config[_binding.key] = key _binding = nil end
      end
      _last_key_state[key] = isDown
   end
end

function drawESP()
   if not _config.esp_active then return end
   local pPosX, pPosY, pPosZ = getCharCoordinates(PLAYER_PED)
   for i = 0, sampGetMaxPlayerId() do
      if sampIsPlayerConnected(i) then
         local result, ped = sampGetCharHandleBySampPlayerId(i)
         if result and ped ~= PLAYER_PED and doesCharExist(ped) and not isCharDead(ped) then
            local posX, posY, posZ = getCharCoordinates(ped) local distance = getDistanceBetweenCoords3d(posX, posY, posZ, pPosX, pPosY, pPosZ)
            if distance <= _config.globalDistance and isCharOnScreen(ped) then
               local wPosX, wPosY = convert3DCoordsToScreen(posX, posY, posZ)
               if wPosX and wPosY then
                  local player_name = sampGetPlayerNickname(i) local skin = nil pcall(function() skin = getCharModel(ped) end)
                  local is_blocked = false
                  if skin and _isTableHasValue(_ignored_skins, skin) then is_blocked = true end
                  if player_name and _isTableHasValue(_ignored_nicks, player_name) then is_blocked = true end
                  local boxColor = is_blocked and _rgbToArgb(_esp_color_blocked, 1.0) or _rgbToArgb(_esp_color_box, 1.0)
                  if _config.esp_box then
                     local boxW, boxH = 60, 95 local left, right, top, bottom = wPosX - boxW/2, wPosX + boxW/2, wPosY - boxH/2 - 15, wPosY + boxH/2 - 15
                     local cL, th = 12, 1.5
                     renderDrawLine(left, top, left + cL, top, th, boxColor) renderDrawLine(left, top, left, top + cL, th, boxColor)
                     renderDrawLine(right, top, right - cL, top, th, boxColor) renderDrawLine(right, top, right, top + cL, th, boxColor)
                     renderDrawLine(left, bottom, left + cL, bottom, th, boxColor) renderDrawLine(left, bottom, left, bottom - cL, th, boxColor)
                     renderDrawLine(right, bottom, right - cL, bottom, th, boxColor) renderDrawLine(right, bottom, right, bottom - cL, th, boxColor)
                  end
                  if _config.esp_skin_id and skin then pcall(function() renderFontDrawText(font, "ID: "..tostring(skin), wPosX - 20, wPosY - 78, _rgbToArgb(_esp_color_id, 1.0)) end) end
                  if _config.esp_names and player_name then local nameColor = is_blocked and boxColor or _rgbToArgb(_esp_color_name, 1.0) renderFontDrawText(font, player_name, wPosX - (#player_name * 3), wPosY - 65, nameColor) end
                  if _config.esp_lines then local screen_w, screen_h = getScreenResolution() local lineColor = is_blocked and boxColor or _rgbToArgb(_esp_color_line, 0.56) renderDrawLine(screen_w/2, screen_h, wPosX, wPosY, 1, lineColor) end
               end
            end
         end
      end
   end
end

