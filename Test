--  RAKNET & EVENTOS (ORIGINAL)
-- ============================================================
function sampev.onSendPlayerSync(data)
   if not _state[0] then return end
   local mode = _getCamMode()
   if _legit and (mode == 53 or mode == 7 or mode == 55) then _sendWeaponSync(_legit.id) else _sendWeaponSync(65535) end
   if not _legit then return end
   local weapon = _getWeapon()
   if not weapon or weapon.id == 24 or weapon.id == 26 or weapon.id == 28 or weapon.id == 32 then return end
   if not isButtonPressed(player, 6) then mode = 4 end
   if not _config.syncrotation or (mode ~= 53 and mode ~= 7) or _legit.dist < _min_fake_dist[0] or _legit.dist > _max_fake_dist[0] then return end
   local my_bone = _getBodyPart(23, PLAYER_PED)
   local a = getHeadingFromVector2d(_legit.bone.x - my_bone.x, _legit.bone.y - my_bone.y) * math.pi / 360.0
   local c1, c2, c3 = math.cos(0), math.cos(a), math.cos(0)
   local s1, s2, s3 = math.sin(0), math.sin(a), math.sin(0)
   data.quaternion[0] = c1 * c2 * c3 - s1 * s2 * s3
   data.quaternion[3] = -(c1 * s2 * c3 - s1 * c2 * s3)
end

function _sendWeaponSync(id)
   if _last_target == id then return end
   _last_target = id
   local bs = raknetNewBitStream()
   raknetBitStreamWriteInt8(bs, 203)
   raknetBitStreamWriteInt16(bs, id)
   raknetSendBitStreamEx(bs, 1, 7, 1)
   raknetDeleteBitStream(bs)
end

function _windowMsgHandler(msg, key, param)
   if _binding and msg == wm.WM_KEYDOWN then
      if key == vkeys.VK_ESCAPE then _binding = nil
      elseif key == vkeys.VK_BACK then _config[_binding.key] = 0; _binding = nil
      else _config[_binding.key] = key; _binding = nil end
   end
end

function _scriptTerminateHandler()
   if _config.wallshot then _config.wallshot = false; _writeWallshot() end
end
