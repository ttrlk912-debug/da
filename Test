local music_audio = nil -- stream da música de fundo (com loop manual)

-- ==============================
-- TOAST SYSTEM (notificações visuais)
-- ==============================
local toasts = {} -- { text, expire, ok }

local function pushToast(text, ok)
    table.insert(toasts, {
        text = text,
        expire = os.clock() + 3.0,
        ok = ok
    })
    while #toasts > 4 do
        table.remove(toasts, 1)
    end
    imgui.Process = true
end

-- ==============================
-- CARREGAMENTO DE IMAGEM / SOM
-- ==============================

local function reloadImage()
    local path = ini.MARKER.IMAGE_PATH
    if not doesFileExist(path) then
        texture = nil
        return false, 'Imagem nao encontrada: ' .. path
    end

    local ok, result = pcall(renderLoadTextureFromFile, path)
    if ok and result then
        texture = result
        collectgarbage()
        return true, 'Imagem carregada com sucesso.'
    else
        texture = nil
        return false, 'Falha ao carregar a imagem (verifique se e um PNG valido). Erro: ' .. tostring(result)
    end
end

-- Pre-carrega todas as PNGs da pasta para uso em random/cycle
local function preloadAllImages()
    image_textures = {}
    image_order = {}
    cycle_index = 1

    for _, filename in ipairs(image_files) do
        local path = IMAGES_DIR .. filename
        local ok, result = pcall(renderLoadTextureFromFile, path)
        if ok and result then
            image_textures[filename] = result
            table.insert(image_order, filename)
        end
    end
    collectgarbage()
    return #image_order
end

-- Escolhe a textura do hit conforme IMAGE_MODE e aplica em `texture`
local function pickHitImage()
    local mode = ini.MARKER.IMAGE_MODE or 'fixed'

    if mode == 'fixed' or #image_order == 0 then
        -- modo fixo: mantém a textura atual (reloadImage já cuidou)
        return
    end

    local chosen = nil

    if mode == 'random' then
        local idx = math.random(1, #image_order)
        chosen = image_order[idx]
    elseif mode == 'cycle' then
        if cycle_index > #image_order then
            cycle_index = 1
        end
        chosen = image_order[cycle_index]
        cycle_index = cycle_index + 1
        if cycle_index > #image_order then
            cycle_index = 1
        end
    end

    if chosen and image_textures[chosen] then
        texture = image_textures[chosen]
    end
end

local function playHitSound()
    if not ini.MARKER.SOUND_ENABLED then
        return
    end

    if audio then
        pcall(setAudioStreamState, audio, 0)
        if releaseAudioStream then pcall(releaseAudioStream, audio) end
        audio = nil
        collectgarbage()
    end

    local ok, streamOrErr = pcall(loadAudioStream, ini.MARKER.SOUND_PATH)
    if not ok or not streamOrErr then
        pushToast('Nao consegui carregar o som de acerto', false)
        return
    end

    audio = streamOrErr
    setAudioStreamVolume(audio, ini.MARKER.SOUND_VOLUME / 100)
    setAudioStreamState(audio, 1)
end

local function playPainSound()
    if not ini.MARKER.PAIN_SOUND_ENABLED then
        return
    end
    if not ini.MARKER.PAIN_SOUND_PATH or ini.MARKER.PAIN_SOUND_PATH == '' then
        pushToast('Nenhum som de "levei tiro" escolhido', false)
        return
    end

    if pain_audio then
        pcall(setAudioStreamState, pain_audio, 0)
        if releaseAudioStream then pcall(releaseAudioStream, pain_audio) end
        pain_audio = nil
        collectgarbage()
    end

    local ok, streamOrErr = pcall(loadAudioStream, ini.MARKER.PAIN_SOUND_PATH)
    if not ok or not streamOrErr then
        pushToast('Nao consegui carregar o som de dano', false)
        return
    end

    pain_audio = streamOrErr
    setAudioStreamVolume(pain_audio, ini.MARKER.PAIN_SOUND_VOLUME / 100)
    setAudioStreamState(pain_audio, 1)
end

-- ==============================
-- MÚSICA DE FUNDO (loop)
-- ==============================

local function stopMusic()
    if music_audio then
        pcall(setAudioStreamState, music_audio, 0)
        if releaseAudioStream then pcall(releaseAudioStream, music_audio) end
        music_audio = nil
        collectgarbage()
    end
end

local function playMusic()
    stopMusic()
    if not ini.MARKER.MUSIC_ENABLED then
        return
    end
    if not ini.MARKER.MUSIC_PATH or ini.MARKER.MUSIC_PATH == '' then
        pushToast('Nenhuma musica escolhida ainda', false)
        return
    end

    local ok, streamOrErr = pcall(loadAudioStream, ini.MARKER.MUSIC_PATH)
    if not ok or not streamOrErr then
        pushToast('Nao consegui carregar a musica', false)
        return
    end

    music_audio = streamOrErr
    setAudioStreamVolume(music_audio, ini.MARKER.MUSIC_VOLUME / 100)
    setAudioStreamState(music_audio, 1)
end

local function triggerHitmarker()
    pickHitImage()
    showUntil = os.clock() + (ini.MARKER.DURATION / 1000)
    playHitSound()
end

function main()
    repeat wait(100) until isSampAvailable()

    ensureDir('moonloader\\hitmarker')
    ensureDir(IMAGES_DIR)
    ensureDir(SOUNDS_DIR)
    refreshFileLists()

    local ok, msg = reloadImage()
    if ok then
        pushToast('Imagem carregada com sucesso', true)
    else
        pushToast('Falha ao carregar imagem inicial', false)
    end

    local preloaded = preloadAllImages()
    sampAddChatMessage('[Hitmarker] Coloque suas imagens (.png) em: ' .. getWorkingDirectory() .. '\\' .. IMAGES_DIR, 0xFF66CCFF)
    sampAddChatMessage('[Hitmarker] Sons: usando a mesma pasta do GameFixer (' .. SOUNDS_DIR .. ')', 0xFF66CCFF)
    sampAddChatMessage('[Hitmarker] Encontrei ' .. #sound_files .. ' som(ns) e ' .. #image_files .. ' imagem(ns) (' .. preloaded .. ' pre-carregadas).', 0xFF66CCFF)

    if ini.MARKER.MUSIC_ENABLED then
        playMusic()
    end

    sampRegisterChatCommand(MENU_COMMAND, function()
        menu_open.v = not menu_open.v
        imgui.Process = true
    end)
    sampAddChatMessage('[Hitmarker] Use /' .. MENU_COMMAND .. ' para configurar imagem, som, posicao, tamanho e duracao.', 0xFF66CCFF)

    addEventHandler('onWindowMessage', function(msg, wparam, lparam)
        if msg == wm.WM_KEYDOWN then
            if binding then
                if wparam ~= vkeys.VK_ESCAPE then
                    ini.MARKER.TESTKEY = wparam
                    saveConfig()
                    pushToast('Tecla de teste atualizada', true)
                end
                binding = false
                consumeWindowMessage()
            end
        end
    end)

    while true do
        wait(0)
        local typing = sampIsChatInputActive() or isSampfuncsConsoleActive() or sampIsDialogActive()
        if ini.MARKER.TEST_ENABLED and not binding and not menu_open.v and not typing and isKeyJustPressed(ini.MARKER.TESTKEY) then
            triggerHitmarker()
        end

        if ini.MARKER.MUSIC_ENABLED and music_audio and getAudioStreamState(music_audio) ~= 1 then
            pcall(setAudioStreamPos, music_audio, 0)
            setAudioStreamState(music_audio, 1)
        end

        local now = os.clock()
        for i = #toasts, 1, -1 do
            if toasts[i].expire < now then
                table.remove(toasts, i)
            end
        end
    end
end


function sampev.onServerMessage(color, text)
    if DEBUG_LOG_MESSAGES then
        sampAddChatMessage('[Hitmarker][DEBUG] ' .. text, 0xFFAAAAAA)
    end

    if not (text:find('DamageInformer') and text:find(' fez ')) then
        return
    end

    if text:find(HIT_RECEIVED_PATTERN) then
        playPainSound()
    else
        triggerHitmarker()
    end
end


