function _rgbToArgb(ptr, alpha)
   if not ptr then return 0xFFFFFFFF end
   local r = math.floor((ptr[0] or 1.0) * 255)
   local g = math.floor((ptr[1] or 1.0) * 255)
   local b = math.floor((ptr[2] or 1.0) * 255)
   local a = math.floor((alpha or 1.0) * 255)
   return bit.bor(bit.lshift(a, 24), bit.lshift(r, 16), bit.lshift(g, 8), b)
end

function _rgbToImVec4(ptr)
   if not ptr then return imgui.ImVec4(1, 1, 1, 1) end
   return imgui.ImVec4(ptr[0], ptr[1], ptr[2], 1.0)
end



