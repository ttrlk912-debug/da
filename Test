function _saveConfig()
   pcall(function()
      if not doesDirectoryExist(_save_dir) then createDirectory(_save_dir) end
      local f = io.open(_save_file, "w")
      if not f then return end
      for real_name, crypto_name in pairs(_save_map) do
         local value = _config[real_name]
         if value ~= nil then
            if type(value) == "boolean" then f:write(crypto_name.."="..tostring(value).."\n")
