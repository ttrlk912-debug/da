function imgui.ToggleButton(str_id, bool)
    local p = imgui.GetCursorScreenPos()
    local dl = imgui.GetWindowDrawList()
    local h = imgui.GetTextLineHeightWithSpacing()
    local w = h * 1.8
    local r = h / 2
    
    if imgui.InvisibleButton(str_id, imgui.ImVec2(w, h)) then
        bool[0] = not bool[0]
    end

    local col = bool[0] and imgui.GetStyle().Colors[imgui.Col.ButtonActive] or imgui.GetStyle().Colors[imgui.Col.FrameBg]
    dl:AddRectFilled(imgui.ImVec2(p.x, p.y), imgui.ImVec2(p.x + w, p.y + h), imgui.GetColorU32Vec4(col), r)
    local circle_x = bool[0] and (p.x + w - r) or (p.x + r)
    dl:AddCircleFilled(imgui.ImVec2(circle_x, p.y + r), r * 0.8, imgui.GetColorU32Vec4(imgui.GetStyle().Colors[imgui.Col.Text]), 12)
    imgui.SameLine()
    imgui.SetCursorPosX(imgui.GetCursorPosX() + w - 10)
    imgui.Text(str_id)
end

function imgui.MenuItem2(index, name, nav_sel)
    local p = imgui.GetCursorScreenPos()
    local dl = imgui.GetWindowDrawList()
    local size = imgui.ImVec2(120, 35)
    local is_selected = (nav_sel[0] == index)
    
    if imgui.InvisibleButton(name .. "##" .. index, size) then
        nav_sel[0] = index
    end
    
    if is_selected or imgui.IsItemHovered() then
        local col = is_selected and imgui.GetStyle().Colors[imgui.Col.SeparatorActive] or imgui.ImVec4(0.3, 0.2, 0.3, 0.4)
        dl:AddRectFilled(p, imgui.ImVec2(p.x + size.x, p.y + size.y), imgui.GetColorU32Vec4(col), 8)
    end
    
    local ts = imgui.CalcTextSize(name)
    dl:AddText(imgui.ImVec2(p.x + 15, p.y + size.y/2 - ts.y/2), imgui.GetColorU32Vec4(imgui.GetStyle().Colors[imgui.Col.Text]), name)
end

