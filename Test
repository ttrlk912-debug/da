-- Botão da sidebar: integrado, texto centralizado, ativo = roxo
local function sidebarButton(label, tabId, width, height)
    local active = current_tab == tabId
    local w = width or 140
    local h = height or 40

    if active then
        local glow = pulse(2.2, 0.0, 0.18)
        local col = imgui.ImVec4(
            COL_PURPLE.x + glow * 0.3,
            COL_PURPLE.y + glow * 0.2,
            COL_PURPLE.z,
            1.0
        )
        imgui.PushStyleColor(imgui.Col.Button, col)
        imgui.PushStyleColor(imgui.Col.ButtonHovered, COL_PURPLE_HOVER)
        imgui.PushStyleColor(imgui.Col.ButtonActive, COL_PURPLE_ACTIVE)
    else
        imgui.PushStyleColor(imgui.Col.Button, imgui.ImVec4(0, 0, 0, 0))
        imgui.PushStyleColor(imgui.Col.ButtonHovered, COL_BG_HOVER)
        imgui.PushStyleColor(imgui.Col.ButtonActive, COL_PURPLE_DIM)
    end

    -- centraliza o texto horizontalmente com espaços
    local pad = math.floor((w - (#label * 7)) / 14)
    if pad < 1 then pad = 1 end
    local spaced = string.rep(" ", pad) .. label .. string.rep(" ", pad)

    local clicked = imgui.Button(spaced .. "##sb" .. tabId, imgui.ImVec2(w, h))
    imgui.PopStyleColor(3)

    if clicked then
        current_tab = tabId
    end
    return clicked
end

