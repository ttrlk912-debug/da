@bot.event
async def on_member_join(member: discord.Member):
    if member.bot:
        return
    settings = get_settings(member.guild.id)
    assigned_role = None
    if settings.get("auto_role_on_join") and settings.get("join_role_id"):
        try:
            join_role_id = int(settings["join_role_id"])
            reward_role_id = int(settings["reward_role_id"]) if settings.get("reward_role_id") else None
        except (TypeError, ValueError):
            join_role_id = reward_role_id = None
        role = member.guild.get_role(join_role_id) if join_role_id else None
        if role and role.id != reward_role_id and not role.managed and member.guild.me and role < member.guild.me.top_role:
            try:
                await member.add_roles(role, reason="Cargo comum de novos membros configurado pelo bot/staff")
                assigned_role = role
            except (discord.Forbidden, discord.HTTPException):
                logger.warning("Não consegui atribuir o cargo de entrada no servidor %s.", member.guild.id)
        elif role and role.id == reward_role_id:
            logger.warning("Cargo automático de entrada igual ao cargo de verificação; atribuição bloqueada no servidor %s.", member.guild.id)

    if settings.get("notify_on_join"):
        await send_member_notification(member.guild, member, "join", assigned_role)


