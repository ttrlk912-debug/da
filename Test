      f:write("pxr_01=".._puxar_max_distance.."\npxr_02=".._puxar_server_cmd.."\n")
      if _ignored_skins then for i, skin in ipairs(_ignored_skins) do f:write("sk_"..string.format("%03d", i).."="..skin.."\n") end end
      if _ignored_nicks then for i, nick in ipairs(_ignored_nicks) do f:write("nk_"..string.format("%03d", i).."="..nick.."\n") end end
