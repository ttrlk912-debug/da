function _puxar_distance3d(x1, y1, z1, x2, y2, z2)
   local dx, dy, dz = x2 - x1, y2 - y1, z2 - z1
   return math.sqrt(dx * dx + dy * dy + dz * dz)
end

function _puxar_normalize(a, b, c, d)
   if type(a) == "boolean" then
      if not a then return nil end
      a, b, c = b, c, d
   end
   if type(a) ~= "number" or type(b) ~= "number" or type(c) ~= "number" then
      return nil
   end
   return a, b, c
end

-- Escaneia e retorna TODAS as armas num raio, ordenadas por distância
function _puxar_scanNearby(px, py, pz)
   local list = {}

   -- Pickups
   for pickupId = 0, 4095 do
      local handle = sampGetPickupHandleBySampId(pickupId)
      if handle and handle ~= 0 and doesPickupExist(handle) then
         local model
         if type(sampGetPickupModelTypeBySampId) == "function" then
            model = sampGetPickupModelTypeBySampId(pickupId)
         elseif type(sampGetPickupModelBySampId) == "function" then
            model = sampGetPickupModelBySampId(pickupId)
         end

         if _weaponModels[model] then
            local x, y, z = _puxar_normalize(getPickupCoordinates(handle))
            if x then
               local dist = _puxar_distance3d(px, py, pz, x, y, z)
               if dist <= _puxar_max_distance then
                  table.insert(list, {
                     model = model,
                     name = _weaponNames[model] or ("Arma #"..model),
                     x = x, y = y, z = z,
                     distance = dist,
                     kind = "pickup",
                     id = pickupId
                  })
               end
            end
         end
      end
   end

   -- Objetos
   for objectId = 0, 999 do
      local handle = sampGetObjectHandleBySampId(objectId)
      if handle and doesObjectExist(handle) then
         local model = getObjectModel(handle)
         if _weaponModels[model] then
            local x, y, z = _puxar_normalize(getObjectCoordinates(handle))
            if x then
               local dist = _puxar_distance3d(px, py, pz, x, y, z)
               if dist <= _puxar_max_distance then
                  table.insert(list, {
                     model = model,
                     name = _weaponNames[model] or ("Objeto #"..model),
                     x = x, y = y, z = z,
                     distance = dist,
                     kind = "object",
                     id = objectId
                  })
               end
            end
         end
      end
   end

   -- Ordena por distância
   table.sort(list, function(a, b) return a.distance < b.distance end)

   return list
end

